---
// ====================================================
// 移动端底部导航栏（全站通用）
// ====================================================
// 为什么放在这里而不是每个页面里：
// 1. 它渲染在 MainGridLayout 里、<main> 之外 —— 所以任何页面（包括直接刷新、
//    从搜索结果直接进来）都会显示，不会像以前那样只有首页才有。
// 2. 图标全部内联成 SVG 路径 —— 不再引用页面里的 <symbol> 符号表，
//    所以 swup 切换页面、符号表被换掉之后，图标也不会消失。
// 3. 它不在 swup 的替换容器（main）里，因此不会被切页动画的 transform 捕获，
//    滚动/切页时不会跳动。
//
// 高亮（哪个标签是当前页面）由 MainGridLayout 里的 initMobileNav() 负责，
// 服务端也会先渲染一次正确的状态，所以即使 JS 没跑也不会错。

const items = [
	{
		href: "/",
		label: "首页",
		matches: ["/"],
		path: '<path fill="currentColor" d="M4 19v-9q0-.475.213-.9t.587-.7l6-4.5q.525-.4 1.2-.4t1.2.4l6 4.5q.375.275.588.7T20 10v9q0 .825-.588 1.413T18 21h-3q-.425 0-.712-.288T14 20v-5q0-.425-.288-.712T13 14h-2q-.425 0-.712.288T10 15v5q0 .425-.288.713T9 21H6q-.825 0-1.412-.587T4 19"/>',
	},
	{
		href: "/posts/",
		label: "文章",
		matches: ["/posts"],
		path: '<path fill="currentColor" d="M5 21q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h14q.825 0 1.413.588T21 5v14q0 .825-.587 1.413T19 21zm0-2h14V5H5zM5 5v14zm3 12h5q.425 0 .713-.288T14 16t-.288-.712T13 15H8q-.425 0-.712.288T7 16t.288.713T8 17m0-4h8q.425 0 .713-.288T17 12t-.288-.712T16 11H8q-.425 0-.712.288T7 12t.288.713T8 13m0-4h8q.425 0 .713-.288T17 8t-.288-.712T16 7H8q-.425 0-.712.288T7 8t.288.713T8 9"/>',
	},
	{
		href: "/appstore/",
		label: "应用",
		// 作品详情页 /projects/... 也属于「应用」这一栏，一起高亮
		matches: ["/appstore", "/projects"],
		path: '<path fill="currentColor" d="m10 9.75l1.325-.65q.325-.15.675-.15t.675.15L14 9.75V5h-4zM8 17q-.425 0-.712-.288T7 16t.288-.712T8 15h3q.425 0 .713.288T12 16t-.288.713T11 17zm-3 4q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h14q.825 0 1.413.588T21 5v14q0 .825-.587 1.413T19 21zM5 5v14zm0 14h14V5h-3v6.375q0 .575-.475.863t-.975.037L12 11l-2.55 1.275q-.5.25-.975-.038T8 11.376V5H5z"/>',
	},
	{
		href: "/novels/",
		label: "阅读",
		matches: ["/novels"],
		path: '<path fill="currentColor" d="M12 19.55q-.275 0-.537-.075t-.488-.2q-1.025-.625-2.15-.95T6.5 18q-1.05 0-2.063.275T2.5 19.05q-.525.275-1.012-.025T1 18.15V6.1q0-.275.138-.525T1.55 5.2q1.15-.6 2.4-.9T6.5 4q1.45 0 2.838.375T12 5.5v12.1q1.275-.8 2.675-1.2T17.5 16q.9 0 1.763.15T21 16.6v-12q.375.125.738.263t.712.337q.275.125.413.375T23 6.1v12.05q0 .575-.487.875t-1.013.025q-.925-.5-1.937-.775T17.5 18q-1.2 0-2.325.325t-2.15.95q-.225.125-.488.2T12 19.55m2.825-5.3q-.25.225-.537.087T14 13.875V5.7q0-.1.038-.188t.112-.162l4-4q.25-.25.55-.125t.3.475v8.575q0 .125-.05.213t-.125.162z"/>',
	},
];

// 服务端先算一次当前路径，保证 HTML 一出来就是正确的高亮状态
const currentPath = Astro.url.pathname;

function isActive(matches: string[], path: string) {
	return matches.some((match) =>
		match === "/" ? path === "/" || path === "" : path === match || path.startsWith(`${match}/`),
	);
}
---

<!-- 给固定导航栏留出滚动空间。
     注意：这里必须用「文档流里的占位元素」，不能给 body 加 padding-bottom ——
     本页内容是绝对定位的，滚动高度由内容溢出决定，body 的 padding 不起作用。 -->
<div class="mobile-nav-spacer lg:hidden" aria-hidden="true"></div>

<nav
	id="mobile-bottom-nav"
	class="lg:hidden"
	aria-label="移动端底部导航"
>
	{
		items.map((item) => (
			<a
				href={item.href}
				class="mobile-nav-item"
				data-nav-match={item.matches.join(" ")}
				data-active={isActive(item.matches, currentPath) ? "true" : "false"}
				aria-current={isActive(item.matches, currentPath) ? "page" : undefined}
			>
				<span class="mobile-nav-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="22" height="22" set:html={item.path} />
				</span>
				<span class="mobile-nav-label">{item.label}</span>
			</a>
		))
	}
</nav>

<style>
  #mobile-bottom-nav {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    /* 父容器（MainGridLayout 里的绝对定位层）带 pointer-events-none，
       这里必须显式恢复，否则四个标签点不动 */
    pointer-events: auto;
    display: flex;
    align-items: stretch;
    /* 注意：<html> 上有 text-[14px] md:text-[16px]，手机端根字号是 14px，
       所以这里的尺寸一律用 px，避免 rem 缩水（3.5rem 会变成 49px 而不是 56px） */
    height: calc(56px + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
    background: color-mix(in oklab, var(--card-bg) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(128, 128, 128, 0.16);
  }

  .mobile-nav-item {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    padding: 0 2px;
    text-decoration: none;
    color: var(--content-meta, #8a8a8a);
    transition: color 0.18s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 28px;
    border-radius: 9999px;
    transition: background-color 0.18s ease;
  }

  .mobile-nav-label {
    font-size: 11px;
    line-height: 1.1;
    font-weight: 500;
    white-space: nowrap;
    transition: font-weight 0.18s ease;
  }

  .mobile-nav-item[data-active="true"] {
    color: var(--primary);
  }

  .mobile-nav-item[data-active="true"] .mobile-nav-icon {
    background: color-mix(in oklab, var(--primary) 14%, transparent);
  }

  .mobile-nav-item[data-active="true"] .mobile-nav-label {
    font-weight: 700;
  }

  /* 占位高度 = 导航栏高度 + 一点余量，手机上保证最后一行内容不被遮住 */
  .mobile-nav-spacer {
    height: calc(76px + env(safe-area-inset-bottom));
  }
</style>
