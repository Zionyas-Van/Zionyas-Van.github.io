---
import { commentsConfig } from "../config";

interface Props {
	serverURL?: string;
}

// 后端地址优先用页面传入的，没传就用 config.ts 里的统一配置
const { serverURL = commentsConfig.serverURL } = Astro.props;
const enabled = commentsConfig.enabled;
---

{
	enabled && (
		<div class="waline-wrapper" data-waline-server={serverURL}>
			<h2 class="waline-title">
				<span>💬</span> 评论
			</h2>
			<div id="waline-comments" />
		</div>
	)
}

<style>
  .waline-wrapper {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(128, 128, 128, 0.1);
  }
  .waline-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>

<script>
  let walineInstance = null;

  async function initWaline() {
    const wrapper = document.querySelector(".waline-wrapper");
    const container = document.getElementById("waline-comments");

    // 评论区在 config.ts 里被关掉时，页面上根本没有这些元素：
    // 直接退出，连 Waline 的代码和样式都不会被下载。
    if (!wrapper || !container) return;

    const serverURL = wrapper.dataset.walineServer;
    if (!serverURL) return;

    if (walineInstance && typeof walineInstance.destroy === "function") {
      try { walineInstance.destroy(); } catch (e) {}
      walineInstance = null;
    }
    container.innerHTML = "";

    // 按需加载：只有真的要显示评论区时，才去下载 Waline 本体和样式
    const [{ init }] = await Promise.all([
      import("@waline/client"),
      import("@waline/client/waline.css"),
    ]);

    walineInstance = init({
      el: "#waline-comments",
      serverURL: serverURL,
      lang: "zh-CN",
      dark: "html.dark",
      path: location.pathname,
      meta: ["nick", "mail", "link"],
      requiredMeta: ["nick"],
      imageUploader: false,
      search: false,
      reaction: false,
    });
  }

  document.addEventListener("astro:page-load", initWaline);
  if (document.readyState !== "loading") {
    initWaline();
  } else {
    document.addEventListener("DOMContentLoaded", initWaline);
  }
</script>
