---
import type { GetStaticPaths } from "astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { novels } from "../../data/novels";
import { Icon } from "astro-icon/components";

export const getStaticPaths = (() => {
  return novels.map((n) => ({ params: { id: n.id } }));
}) satisfies GetStaticPaths;

const { id } = Astro.params;
const novel = novels.find((n) => n.id === id);

if (!novel) return Astro.redirect("/novels/");
---

<MainGridLayout title={novel.title} description={novel.description}>
  <div class="onload-animation">
    <!-- 封面 + 信息 -->
    <div class="flex flex-col md:flex-row gap-6 mb-8">
      <div class="w-40 md:w-48 flex-shrink-0">
        <div class="aspect-[3/4] rounded-[var(--radius-large)] overflow-hidden bg-black/10 dark:bg-white/5">
          <img src={novel.cover} alt={novel.title} class="w-full h-full object-cover" />
        </div>
      </div>
      <div class="flex-1 min-w-0">
        <h1 class="text-2xl md:text-3xl font-bold text-90 mb-3">{novel.title}</h1>
        <div class="flex flex-wrap items-center gap-3 text-sm text-75 mb-4">
          <span>著作：{novel.author}</span>
          <span>发布日期：{novel.publishedDate}</span>
          <span>已发布平台：{novel.platform}</span>
          <span>共 {novel.chapters.length} 章</span>
        </div>
        <p class="text-75 leading-relaxed whitespace-pre-line">{novel.intro}</p>
      </div>
    </div>

    <!-- 章节列表 -->
    <div class="card-base rounded-[var(--radius-large)] p-6">
      <h2 class="text-lg font-bold text-90 mb-4 flex items-center gap-2">
        <Icon name="material-symbols:list-alt-outline-rounded" class="text-[var(--primary)] text-[1.25rem]" />
        目录
      </h2>
      {novel.chapters.length > 0 ? (
        <div class="divide-y divide-black/5 dark:divide-white/10">
          {novel.chapters.map((ch, i) => (
            <a
              href={`/novels/${novel.id}/${ch.slug}/`}
              class="flex items-center gap-3 py-3 px-2 rounded-lg
                     hover:bg-[var(--primary)]/5 transition-colors group"
            >
              <span class="text-xs text-75/40 font-mono w-8 text-right flex-shrink-0">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="text-sm text-90 group-hover:text-[var(--primary)] transition-colors flex-1">
                {ch.title}
                {ch.date && <span class="text-xs text-black/30 dark:text-white/30 ml-2">{ch.date}</span>}
              </span>
              <Icon name="material-symbols:chevron-right-rounded" class="text-75/30 text-[1rem]" />
            </a>
          ))}
        </div>
      ) : (
        <p class="text-sm text-75/50">暂无章节</p>
      )}
    </div>

    <!-- 返回 -->
    <div class="mt-6">
      <a href="/novels/" class="inline-flex items-center gap-1 text-sm text-[var(--primary)] hover:underline">
        <Icon name="material-symbols:arrow-back-rounded" class="text-[1rem]" />
        返回故事列表
      </a>
    </div>
  </div>
</MainGridLayout>
