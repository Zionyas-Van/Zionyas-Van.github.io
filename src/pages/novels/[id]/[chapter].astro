---
import type { GetStaticPaths } from "astro";
import MarkdownIt from "markdown-it";
import { novels } from "../../../data/novels";
import ReaderLayout from "../../../layouts/ReaderLayout.astro";

export const getStaticPaths = (() => {
	const paths: { params: { id: string; chapter: string } }[] = [];
	for (const n of novels) {
		for (const ch of n.chapters) {
			paths.push({ params: { id: n.id, chapter: ch.slug } });
		}
	}
	return paths;
}) satisfies GetStaticPaths;

const { id, chapter } = Astro.params;
const novel = novels.find((n) => n.id === id);
if (!novel) return Astro.redirect("/novels/");

const ch = novel.chapters.find((c) => c.slug === chapter);
if (!ch) return Astro.redirect(`/novels/${novel.id}/`);

const chapterIndex = novel.chapters.indexOf(ch);
const prevChapter = chapterIndex > 0 ? novel.chapters[chapterIndex - 1] : null;
const nextChapter =
	chapterIndex < novel.chapters.length - 1 ? novel.chapters[chapterIndex + 1] : null;

const md = new MarkdownIt({ html: false, breaks: true, linkify: true });
const unescaped = String(ch.content || "")
	.replace(/\\n/g, "\n")
	.replace(/\\"/g, '"')
	.replace(/\\\\/g, "\\");
const renderedContent = md.render(unescaped);

const chapters = novel.chapters.map((c) => ({ slug: c.slug, title: c.title }));
---

<ReaderLayout
	chapterTitle={ch.title}
	pageTitle={`${ch.title} - ${novel.title}`}
	description={novel.description}
	novelId={novel.id}
	novelTitle={novel.title}
	chapters={chapters}
	currentSlug={ch.slug}
	prev={prevChapter ? { slug: prevChapter.slug, title: prevChapter.title } : null}
	next={nextChapter ? { slug: nextChapter.slug, title: nextChapter.title } : null}
>
	{
		renderedContent.trim() ? (
			<Fragment set:html={renderedContent} />
		) : (
			<p>这一章还没有内容。</p>
		)
	}
</ReaderLayout>
