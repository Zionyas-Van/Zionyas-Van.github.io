---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import MarkdownIt from "markdown-it";
import { novels } from "../../../data/novels";
import MainGridLayout from "../../../layouts/MainGridLayout.astro";

export const getStaticPaths = (() => {
	const paths: { params: { id: string; chapter: string } }[] = [];
	for (const n of novels) {
		for (const ch of n.chapters) {
			paths.push({ params: { id: n.id, chapter: ch.slug } });
		}
	}
	return paths;
}) satisfies GetStaticPaths;

const { id, chapter } = Astro.params;
const novel = novels.find((n) => n.id === id);
if (!novel) return Astro.redirect("/novels/");

const ch = novel.chapters.find((c) => c.slug === chapter);
if (!ch) return Astro.redirect(`/novels/${novel.id}/`);

const chapterIndex = novel.chapters.indexOf(ch);
const prevChapter = chapterIndex > 0 ? novel.chapters[chapterIndex - 1] : null;
const nextChapter =
	chapterIndex < novel.chapters.length - 1
		? novel.chapters[chapterIndex + 1]
		: null;

const md = new MarkdownIt({ html: false, breaks: true, linkify: true });
const unescaped = ch.content
	.replace(/\\n/g, "\n")
	.replace(/\\"/g, '"')
	.replace(/\\\\/g, "\\");
const renderedContent = md.render(unescaped);

const currentNum = chapterIndex + 1;
const totalNum = novel.chapters.length;
---

<MainGridLayout title={`${ch.title} - ${novel.title}`} description={novel.description}>

  <!-- 阅读模式标记：MainGridLayout 的脚本读它并隐藏侧边栏 -->
  <div id="reader-mode-marker" style="display:none" aria-hidden="true"></div>

  <!-- ===== Sticky 阅读工具栏 ===== -->
  <div class="sticky top-20 z-30 -mx-4 px-4 py-3 mb-12
              bg-[var(--card-bg)]/95 backdrop-blur-lg
              border-b border-black/5 dark:border-white/10
              shadow-sm">
    <div class="flex items-center justify-between gap-3 max-w-3xl mx-auto">
      <!-- 左：返回目录 -->
      <a href={`/novels/${novel.id}/`}
         class="flex items-center gap-1.5 text-sm text-75 hover:text-[var(--primary)] transition-colors flex-shrink-0 px-2 py-1">
        <Icon name="material-symbols:list-alt-outline-rounded" class="text-[1.15rem]" />
        <span class="hidden sm:inline">目录</span>
      </a>

      <!-- 中：章节进度 -->
      <div class="text-xs text-75/70 truncate text-center flex-1 min-w-0">
        <span class="hidden md:inline">{novel.title} · </span>
        <span>{currentNum} / {totalNum}</span>
      </div>

      <!-- 右：字号切换 -->
      <div class="flex items-center gap-0.5 flex-shrink-0" id="font-size-group">
        <button type="button" data-size="sm" title="小字号"
          class="font-size-btn w-8 h-8 rounded-md text-xs font-semibold transition-colors">A</button>
        <button type="button" data-size="md" title="中字号"
          class="font-size-btn w-8 h-8 rounded-md text-sm font-semibold transition-colors">A</button>
        <button type="button" data-size="lg" title="大字号"
          class="font-size-btn w-8 h-8 rounded-md text-base font-semibold transition-colors">A</button>
      </div>
    </div>
  </div>

  <!-- ===== 阅读主体（居中窄栏 + 移动端留内边距） ===== -->
  <article class="mx-auto max-w-3xl px-3 sm:px-4 md:px-0 onload-animation">

    <!-- 章节标题 -->
    <header class="mb-10 text-center">
      <div class="text-xs text-75/50 mb-2 tracking-widest">第 {currentNum} 章</div>
      <h1 class="text-2xl md:text-3xl font-bold text-90 mb-3 leading-snug">{ch.title}</h1>
      {ch.date && <p class="text-xs text-75/40">发布于 {ch.date}</p>}
    </header>

    <!-- 正文 -->
    <div id="chapter-content"
         class="novel-content text-90
                [&>p]:mb-5
                [&>p>img]:max-w-full [&>p>img]:rounded-lg [&>p>img]:mx-auto [&>p>img]:my-6
                [&>h2]:text-xl [&>h2]:md:text-2xl [&>h2]:font-bold [&>h2]:mt-10 [&>h2]:mb-4
                [&>h3]:text-lg [&>h3]:md:text-xl [&>h3]:font-semibold [&>h3]:mt-8 [&>h3]:mb-3
                [&>blockquote]:border-l-4 [&>blockquote]:border-[var(--primary)]/40 [&>blockquote]:pl-4 [&>blockquote]:italic [&>blockquote]:text-75 [&>blockquote]:my-6
                [&>ul]:list-disc [&>ul]:pl-6 [&>ul]:mb-5
                [&>ol]:list-decimal [&>ol]:pl-6 [&>ol]:mb-5
                [&>li]:mb-2
                [&>hr]:my-8 [&>hr]:border-black/10 dark:[&>hr]:border-white/10"
         style="word-spacing: 0.05em;"
         set:html={renderedContent}>
    </div>

    <!-- 章末装饰 -->
    <div class="flex items-center justify-center gap-4 my-12 text-75/30">
      <div class="h-px w-16 bg-current"></div>
      <span class="text-sm tracking-widest">· · ·</span>
      <div class="h-px w-16 bg-current"></div>
    </div>

    <p class="text-center text-xs text-75/40 mb-10 tracking-widest">— 本章完 —</p>

    <!-- 上/下章导航 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-8">
      {prevChapter ? (
        <a href={`/novels/${novel.id}/${prevChapter.slug}/`}
           class="card-base rounded-[var(--radius-large)] px-5 py-4
                  hover:bg-[var(--primary)]/5 transition-colors group
                  flex items-center gap-3 min-w-0">
          <Icon name="material-symbols:chevron-left-rounded" class="text-[var(--primary)] text-[1.5rem] flex-shrink-0" />
          <div class="min-w-0 flex-1">
            <div class="text-xs text-75/40 mb-0.5">上一章</div>
            <div class="text-sm font-medium text-90 group-hover:text-[var(--primary)] transition-colors truncate">
              {prevChapter.title}
            </div>
          </div>
        </a>
      ) : (
        <div class="card-base rounded-[var(--radius-large)] px-5 py-4
                    flex items-center gap-3 opacity-40">
          <div class="text-sm text-75">已是第一章</div>
        </div>
      )}

      {nextChapter ? (
        <a href={`/novels/${novel.id}/${nextChapter.slug}/`}
           class="card-base rounded-[var(--radius-large)] px-5 py-4
                  hover:bg-[var(--primary)]/5 transition-colors group
                  flex items-center gap-3 min-w-0 md:flex-row-reverse md:text-right">
          <Icon name="material-symbols:chevron-right-rounded" class="text-[var(--primary)] text-[1.5rem] flex-shrink-0" />
          <div class="min-w-0 flex-1">
            <div class="text-xs text-75/40 mb-0.5">下一章</div>
            <div class="text-sm font-medium text-90 group-hover:text-[var(--primary)] transition-colors truncate">
              {nextChapter.title}
            </div>
          </div>
        </a>
      ) : (
        <div class="card-base rounded-[var(--radius-large)] px-5 py-4
                    flex items-center gap-3 opacity-40">
          <div class="text-sm text-75">已读完最后一章</div>
        </div>
      )}
    </div>

    <!-- 返回目录大按钮 -->
    <div class="text-center mb-8">
      <a href={`/novels/${novel.id}/`}
         class="inline-flex items-center gap-2 px-6 py-3 rounded-full
                bg-[var(--primary)] text-white text-sm font-semibold
                hover:opacity-90 active:scale-95 transition-all
                shadow-lg shadow-[var(--primary)]/20">
        <Icon name="material-symbols:auto-stories-rounded" class="text-[1.15rem]" />
        返回目录
      </a>
    </div>

  </article>
</MainGridLayout>

<style>
  /* 字号通过 class 切换（不依赖属性选择器，兼容 scoped style） */
  #chapter-content {
    font-size: 1.125rem;
    line-height: 2;
    letter-spacing: 0.01em;
  }
  #chapter-content.size-sm { font-size: 1rem;     line-height: 1.9;  }
  #chapter-content.size-md { font-size: 1.125rem; line-height: 2;    }
  #chapter-content.size-lg { font-size: 1.25rem;  line-height: 2.15; }

  /* 移动端字号略小 */
  @media (max-width: 767px) {
    #chapter-content         { font-size: 1rem;      line-height: 1.9;  }
    #chapter-content.size-sm { font-size: 0.9375rem; line-height: 1.85; }
    #chapter-content.size-md { font-size: 1rem;      line-height: 1.9;  }
    #chapter-content.size-lg { font-size: 1.0625rem; line-height: 2;    }
  }

  /* 字号按钮 */
  .font-size-btn {
    color: var(--content-meta, #9ca3af);
    background: transparent;
    cursor: pointer;
  }
  .font-size-btn:hover {
    color: var(--primary);
    background: rgba(124, 58, 237, 0.08);
  }
  .font-size-btn[data-active="true"] {
    color: var(--primary) !important;
    background: rgba(124, 58, 237, 0.08) !important;
  }
</style>

<script>
  function initReader() {
    const content = document.getElementById("chapter-content");
    const group = document.getElementById("font-size-group");
    if (!content || !group) return;

    const KEY = "novel-font-size";
    const applySize = (size) => {
      // 用 class 控制字号（最稳，不受 scoped style 影响）
      content.classList.remove("size-sm", "size-md", "size-lg");
      content.classList.add("size-" + size);
      // 按钮高亮
      group.querySelectorAll(".font-size-btn").forEach((b) => {
        b.dataset.active = b.dataset.size === size ? "true" : "false";
      });
      try { localStorage.setItem(KEY, size); } catch {}
    };

    // 事件绑定（每次切页后新 DOM 都是新的，需要重新绑）
    if (group.dataset.bound !== "1") {
      group.dataset.bound = "1";
      group.querySelectorAll(".font-size-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          applySize(btn.dataset.size || "md");
        });
      });
    }

    // 恢复上次字号
    let saved = "md";
    try { saved = localStorage.getItem(KEY) || "md"; } catch {}
    applySize(saved);

    // ---- 阅读进度条 ----
    let bar = document.getElementById("reading-progress");
    if (!bar) {
      bar = document.createElement("div");
      bar.id = "reading-progress";
      bar.style.cssText =
        "position:fixed;top:0;left:0;height:2px;width:0;z-index:60;" +
        "background:var(--primary);transition:width .12s linear;pointer-events:none;";
      document.body.appendChild(bar);
    }

    const updateProgress = () => {
      const h = document.documentElement;
      const top = h.scrollTop || document.body.scrollTop;
      const total = h.scrollHeight - h.clientHeight;
      const pct = total > 0 ? (top / total) * 100 : 0;
      bar.style.width = pct + "%";
    };

    if (window.__readerProgressBound !== true) {
      window.__readerProgressBound = true;
      window.addEventListener("scroll", updateProgress, { passive: true });
    }
    updateProgress();
  }

  initReader();
  ["page:view", "swup:page:view", "astro:page-load"].forEach((evt) => {
    document.addEventListener(evt, initReader);
  });
</script>