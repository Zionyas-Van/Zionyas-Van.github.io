---
import { Icon } from "astro-icon/components";
import { videos } from "../data/videos";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const featuredVideos = videos.filter((v) => v.featured);
const hasFeatured = featuredVideos.length > 0;
---

<MainGridLayout title="视频" description="我的视频作品">

  <!-- ==================== 顶部精选 Banner ==================== -->
  {hasFeatured && (
    <div class="onload-animation mb-8">
      <div class="video-banner-scroll flex gap-3 overflow-x-auto snap-x snap-mandatory -mx-2 px-2 pb-2 max-md:scroll-pl-2">
        {featuredVideos.map((v) => (
          <a href={`/videos/${v.id}/`}
             class="snap-start flex-shrink-0 w-full relative aspect-video
                    rounded-[var(--radius-large)] overflow-hidden group
                    ring-1 ring-black/5 dark:ring-white/10">
            <img src={v.cover} alt={v.title}
                 class="absolute inset-0 w-full h-full object-cover
                        transition duration-500 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-4 md:p-7 text-white">
              <div class="text-[11px] font-semibold tracking-[0.2em] mb-2 opacity-80">
                精选视频
              </div>
              <h2 class="text-sm md:text-2xl font-bold mb-2 line-clamp-2 leading-snug">
                {v.title}
              </h2>
              <p class="text-xs md:text-sm opacity-85 line-clamp-1 hidden md:block">
                {v.description}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- ==================== 视频网格 ==================== -->
  {videos.length > 0 ? (
    <div class="onload-animation">
      <h2 class="text-lg font-bold text-90 mb-4 px-1">全部视频</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
        {videos.map((v) => (
          <a href={`/videos/${v.id}/`}
             class="card-base group rounded-xl overflow-hidden
                    hover:scale-[1.02] active:scale-100 transition-transform duration-200">
            <div class="aspect-video w-full overflow-hidden bg-black/10 dark:bg-white/5 relative">
              <img src={v.cover} alt={v.title}
                   class="w-full h-full object-cover transition group-hover:scale-105 duration-300"
                   loading="lazy" />
              {v.featured && (
                <div class="absolute top-1.5 left-1.5 px-1.5 py-0.5 rounded-md
                            bg-[var(--primary)] text-white text-[10px] font-semibold
                            shadow-md">
                  精选
                </div>
              )}
            </div>
            <div class="p-2.5 md:p-3">
              <h3 class="font-medium text-xs md:text-sm text-90 leading-snug line-clamp-2
                         group-hover:text-[var(--primary)] transition-colors">
                {v.title}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  ) : (
    <div class="card-base rounded-[var(--radius-large)] p-8 md:p-12 text-center text-75 onload-animation">
      <Icon name="material-symbols:list-alt-outline-rounded" class="text-6xl mx-auto mb-4 opacity-25" />
      <p class="font-medium text-lg text-90 mb-2">暂无视频</p>
      <p class="text-sm">还没有发布视频，敬请期待～</p>
    </div>
  )}
</MainGridLayout>

<style is:global>
  .video-banner-scroll::-webkit-scrollbar { display: none; }
  .video-banner-scroll { scrollbar-width: none; -ms-overflow-style: none; }
</style>