---
// ============================================
// 旧博客分页 URL 重定向
// 原来的 /2, /3, /4... 自动跳转到 /posts/2, /posts/3...
// ============================================
const { page } = Astro.params;

if (page && /^\d+$/.test(page)) {
	return Astro.redirect(`/posts/${page}`);
}
return Astro.redirect("/posts/");
---
