---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { INTEREST_TYPE_FIELDS, INTEREST_TYPE_META, interestSections } from "../../data/interests";
import {
	fmtMinutes,
	fmtRating,
	postsOfSection,
	sectionFirstDate,
	sectionMaxMinutes,
	sectionMaxRating,
} from "../../utils/interests";

export function getStaticPaths() {
	return interestSections.map((s) => ({ params: { id: s.id }, props: { section: s } }));
}

const { section } = Astro.props;
const posts = postsOfSection(section.id);
const meta = INTEREST_TYPE_META[section.type];
const fields = INTEREST_TYPE_FIELDS[section.type];
const maxMin = sectionMaxMinutes(section.id);
const maxRate = sectionMaxRating(section.id);
const firstDate = sectionFirstDate(section.id);
const lastDate = posts.length ? String(posts[0].date || "") : "";
---

<MainGridLayout title={section.name} description={section.description || `${section.name} 的记录`}>
  <div class="flex items-center gap-2 mb-3">
    <a href="/interests/" class="inline-flex items-center gap-1 text-[13px] text-[var(--primary)] hover:underline">
      <Icon name="material-symbols:arrow-back-rounded" class="text-[1rem]" />
      全部兴趣
    </a>
  </div>

  <!-- ============ 分区头部 ============ -->
  <div class="card-base rounded-[var(--radius-large)] overflow-hidden mb-5">
    <div class="relative aspect-[16/7] md:aspect-[21/7] w-full overflow-hidden bg-black/10 dark:bg-white/10">
      {
        section.cover ? (
          <img src={section.cover} alt={section.name} class="w-full h-full object-cover" />
        ) : (
          <div class="w-full h-full flex items-center justify-center text-[var(--primary)]/40">
            <Icon name={meta.icon} class="text-5xl" />
          </div>
        )
      }
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent pointer-events-none"></div>
      <div class="absolute inset-x-0 bottom-0 p-4 md:p-5">
        <span class="inline-flex items-center gap-1 text-[11px] font-semibold px-2.5 py-1 rounded-full bg-[var(--primary)] text-white mb-2">
          <Icon name={meta.icon} class="text-[0.95rem]" />
          {meta.label}
        </span>
        <h1 class="text-white font-bold text-xl md:text-2xl leading-snug">{section.name}</h1>
        {section.description && (
          <p class="text-white/80 text-[13px] mt-1 line-clamp-2">{section.description}</p>
        )}
      </div>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5 p-3.5 md:p-4">
      <div class="rounded-[var(--radius-medium)] bg-[var(--primary)]/6 px-3 py-2.5">
        <div class="text-[11px] text-75 mb-0.5">{fields.minutes ? "累计时长（取最大值）" : fields.rating ? "最高评分" : "记录数"}</div>
        <div class="font-bold text-[var(--primary)] text-[15px]">
          {fields.minutes ? fmtMinutes(maxMin) : fields.rating ? `${fmtRating(maxRate)} 分` : `${posts.length} 条`}
        </div>
      </div>
      <div class="rounded-[var(--radius-medium)] bg-[var(--primary)]/6 px-3 py-2.5">
        <div class="text-[11px] text-75 mb-0.5">记录</div>
        <div class="font-bold text-[var(--primary)] text-[15px]">{posts.length} 条</div>
      </div>
      <div class="rounded-[var(--radius-medium)] bg-[var(--primary)]/6 px-3 py-2.5">
        <div class="text-[11px] text-75 mb-0.5">开始</div>
        <div class="font-bold text-[var(--primary)] text-[15px] truncate">{firstDate || "—"}</div>
      </div>
      <div class="rounded-[var(--radius-medium)] bg-[var(--primary)]/6 px-3 py-2.5">
        <div class="text-[11px] text-75 mb-0.5">最近</div>
        <div class="font-bold text-[var(--primary)] text-[15px] truncate">{lastDate || "—"}</div>
      </div>
    </div>
  </div>

  <!-- ============ 帖子 ============ -->
  <div class="flex items-center justify-between mb-3">
    <h2 class="text-lg font-bold text-90 flex items-center gap-2">
      <Icon name="material-symbols:article-outline-rounded" class="text-[var(--primary)] text-[1.25rem]" />
      全部记录
    </h2>
    <input
      id="section-post-search"
      class="h-[34px] px-3.5 rounded-full border border-black/10 dark:border-white/15 bg-transparent text-[13px] outline-none focus:border-[var(--primary)] w-40"
      type="text"
      placeholder="搜索标题或内容"
      autocomplete="off"
    />
  </div>

  {
    posts.length === 0 ? (
      <div class="card-base rounded-[var(--radius-large)] p-10 text-center text-75">
        <Icon name="material-symbols:history-rounded" class="text-5xl mb-3 opacity-25 mx-auto" />
        <p class="text-sm">这个分区还没有记录</p>
      </div>
    ) : (
      <div id="section-posts" class="flex flex-col gap-3">
        {posts.map((p) => (
          <article
            class="card-base rounded-[var(--radius-large)] p-4 md:p-5"
            data-post
            data-time={p.date}
            data-text={`${p.title} ${p.content || ""}`.toLowerCase()}
          >
            <div class="flex items-start justify-between gap-3 mb-2">
              <div class="min-w-0">
                <h3 class="font-bold text-[15px] md:text-base text-90">{p.title}</h3>
                <div class="flex items-center gap-2 mt-1 text-[11.5px] text-75/70 flex-wrap">
                  <span>{p.date}</span>
                  <span class="text-[var(--primary)]" data-elapsed></span>
                  {fields.minutes && (p.minutes || 0) > 0 && (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] font-semibold">
                      <Icon name="material-symbols:timer-outline-rounded" class="text-[0.85rem]" />
                      {fmtMinutes(p.minutes || 0)}
                    </span>
                  )}
                  {fields.rating && (p.rating || 0) > 0 && (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] font-semibold">
                      <Icon name="material-symbols:star-rounded" class="text-[0.85rem]" />
                      {fmtRating(p.rating)} / 10
                    </span>
                  )}
                </div>
              </div>
            </div>
            {p.content && (
              <p class="text-[13.5px] text-75 leading-relaxed whitespace-pre-line mt-2">{p.content}</p>
            )}
            {(p.screenshots || []).length > 0 && (
              <div class="grid grid-cols-2 md:grid-cols-3 gap-2 mt-3">
                {(p.screenshots || []).map((src) => (
                  <div class="aspect-video rounded-[var(--radius-small)] overflow-hidden bg-black/10 dark:bg-white/10">
                    <img src={src} alt="" data-zoom class="w-full h-full object-cover cursor-zoom-in" loading="lazy" />
                  </div>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    )
  }
  <p id="section-posts-empty" class="hidden card-base rounded-[var(--radius-large)] p-8 text-center text-75 text-sm mt-3">
    没有匹配的记录
  </p>
</MainGridLayout>
