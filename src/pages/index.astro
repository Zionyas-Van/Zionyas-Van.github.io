---
// ============================================
// 首页 · 主舞台 + 侧边栏 + 移动端专属 UI
// ============================================

import { Icon } from "astro-icon/components";
import PostCard from "../components/PostCard.astro";
import { INTEREST_TYPE_META, interestSections } from "../data/interests";
import { novels } from "../data/novels";
import { projects } from "../data/projects";
import { resources } from "../data/resources";
import { videos } from "../data/videos";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import {
	getSortedDailyPosts,
	getSortedPostsExcludingDaily,
} from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";

// 所有非日常文章
const allNonDaily = await getSortedPostsExcludingDaily();

// 新闻（category = "新闻"）· 最多 8 条
const newsPosts = allNonDaily
	.filter((p) => p.data.category === "新闻")
	.slice(0, 8);

// 普通文章（排除新闻）· 最新 4 篇
const latestPosts = allNonDaily
	.filter((p) => p.data.category !== "新闻")
	.slice(0, 4);

// 日常 · 最新 4 篇
const dailyPosts = (await getSortedDailyPosts()).slice(0, 4);

// 首页精选
const featuredProjects = projects.filter((p) => p.featured);
const featuredVideos = videos.filter((v) => v.featured);

type FeaturedItem =
	| {
			kind: "project";
			title: string;
			description: string;
			cover: string;
			type: "game" | "software";
			tags: string[];
			url?: string;
	  }
	| {
			kind: "video";
			title: string;
			description: string;
			bvid: string;
			cover: string;
	  };

const featuredItems: FeaturedItem[] = [
	...featuredProjects.map((p) => ({ kind: "project" as const, ...p })),
	...featuredVideos.map((v) => ({
		kind: "video" as const,
		cover: v.cover || "",
		...v,
	})),
];

const hasFeatured = featuredItems.length > 0;

// 新闻日期格式化：MM-DD
const formatNewsDate = (d: unknown) => {
	try {
		const date = d instanceof Date ? d : new Date(d as string);
		if (Number.isNaN(date.getTime())) return "";
		const m = String(date.getMonth() + 1).padStart(2, "0");
		const day = String(date.getDate()).padStart(2, "0");
		return `${m}-${day}`;
	} catch {
		return "";
	}
};
---

<MainGridLayout>

  <!-- ==================================================== -->
  <!-- ① 猜你喜欢（桌面 2 列 / 移动端横滑）                    -->
  <!-- ==================================================== -->
  {hasFeatured && (
    <div class="mb-8 max-md:mb-6">
      <div class="flex items-center justify-between mb-5 max-md:mb-3">
        <h2 class="text-lg font-bold text-90 flex items-center gap-2">
          <Icon name="material-symbols:star-rounded" class="text-[var(--primary)] text-[1.25rem]" />
          猜你喜欢
        </h2>
      </div>
      <!-- ================= 桌面端：一张大图轮播 + 右侧待播小列表 ================= -->
      <div class="hidden md:grid md:grid-cols-[minmax(0,1fr)_19rem] gap-4" data-featured data-interval="6000">
        <!-- 左侧大图 -->
        <div class="feat-stage card-base rounded-[var(--radius-large)] overflow-hidden relative">
          {featuredItems.map((item, i) => {
            const isProj = item.kind === "project";
            const href = isProj ? `/projects/${item.id}/` : `https://www.bilibili.com/video/${item.bvid}`;
            const kindText = isProj ? (item.type === "game" ? "游戏" : "软件") : "视频";
            return (
              <a
                href={href}
                target={isProj ? undefined : "_blank"}
                rel={isProj ? undefined : "noopener noreferrer"}
                class="feat-slide group"
                data-slide={i}
                data-active={i === 0 ? "1" : "0"}
              >
                {item.cover ? (
                  <img src={item.cover} alt={item.title} loading={i === 0 ? "eager" : "lazy"} class="feat-cover" />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-blue-900/40 to-pink-900/40"></div>
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-transparent pointer-events-none"></div>

                {!isProj && (
                  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                    <div class="w-16 h-16 rounded-full bg-white/90 flex items-center justify-center shadow-xl transition duration-300 group-hover:scale-110">
                      <Icon name="material-symbols:play-arrow-rounded" class="text-gray-900 text-3xl ml-0.5" />
                    </div>
                  </div>
                )}

                <div class="absolute inset-x-0 bottom-0 p-6 max-w-3xl pointer-events-none">
                  <span
                    class:list={[
                      "inline-flex items-center text-[11px] font-semibold px-2.5 py-1 rounded-full mb-3 text-white",
                      isProj ? "bg-[var(--primary)]" : "bg-red-500",
                    ]}
                  >
                    {kindText}
                  </span>
                  <h3 class="text-white font-bold text-xl lg:text-2xl leading-snug mb-2 line-clamp-2">{item.title}</h3>
                  <p class="text-white/75 text-sm leading-relaxed line-clamp-2 mb-3">{item.description}</p>
                  <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-white/90 group-hover:text-white transition">
                    查看详情
                    <Icon name="material-symbols:chevron-right-rounded" class="text-[1.1rem] transition group-hover:translate-x-0.5" />
                  </span>
                </div>
              </a>
            );
          })}

          <!-- 左右切换 -->
          <div class="absolute top-4 right-4 flex gap-2 z-10">
            <button type="button" class="feat-nav" data-feat-prev aria-label="上一个">
              <Icon name="material-symbols:chevron-left-rounded" class="text-[1.3rem]" />
            </button>
            <button type="button" class="feat-nav" data-feat-next aria-label="下一个">
              <Icon name="material-symbols:chevron-right-rounded" class="text-[1.3rem]" />
            </button>
          </div>

          <!-- 进度圆点 -->
          {featuredItems.length > 1 && (
            <div class="absolute bottom-5 right-6 flex items-center gap-1.5 z-10">
              {featuredItems.map((_, i) => (
                <button
                  type="button"
                  class="feat-dot"
                  data-feat-dot={i}
                  data-active={i === 0 ? "1" : "0"}
                  aria-label={`切换到第 ${i + 1} 个`}
                ></button>
              ))}
            </div>
          )}
        </div>

        <!-- 右侧：等待轮播的小列表 -->
        <div class="flex flex-col gap-3">
          {featuredItems.length > 1 && (
            <div class="text-[11px] font-semibold text-30 uppercase tracking-[0.12em] px-1">接下来</div>
          )}
          {featuredItems.map((item, i) => {
            const isProj = item.kind === "project";
            return (
              <button type="button" class="feat-item" data-feat-thumb={i} data-active={i === 0 ? "1" : "0"}>
                <span class="feat-thumb">
                  {item.cover ? <img src={item.cover} alt="" loading="lazy" /> : null}
                </span>
                <span class="feat-item-body">
                  <b>{item.title}</b>
                  <em>{isProj ? (item.type === "game" ? "游戏" : "软件") : "视频"}</em>
                </span>
              </button>
            );
          })}
        </div>
      </div>

      <!-- ================= 手机端：可左右滑动 + 自动播放的 Play 风格轮播 ================= -->
      <div
        class="md:hidden flex gap-3 overflow-x-auto snap-x snap-mandatory pb-1"
        data-mcarousel
        data-interval="5000"
        style="scrollbar-width: none;"
      >
        {featuredItems.map((item, i) => {
          const isProj = item.kind === "project";
          const href = isProj ? `/projects/${item.id}/` : `https://www.bilibili.com/video/${item.bvid}`;
          return (
            <a
              href={href}
              target={isProj ? undefined : "_blank"}
              rel={isProj ? undefined : "noopener noreferrer"}
              class="snap-center shrink-0 w-[85%] card-base rounded-[22px] overflow-hidden"
              data-mcard={i}
            >
              <!-- 大图 + 叠在上面的文案（Play 的海报式标题） -->
              <div class="relative aspect-[16/10] w-full overflow-hidden bg-black/10 dark:bg-white/5">
                {item.cover ? (
                  <img
                    src={item.cover}
                    alt={item.title}
                    class="w-full h-full object-cover"
                    loading={i === 0 ? "eager" : "lazy"}
                  />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-blue-900/40 to-pink-900/40"></div>
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent pointer-events-none"></div>
                {!isProj && (
                  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                    <div class="w-12 h-12 rounded-full bg-white/90 flex items-center justify-center shadow-lg">
                      <Icon name="material-symbols:play-arrow-rounded" class="text-gray-900 text-2xl ml-0.5" />
                    </div>
                  </div>
                )}
                <div class="absolute inset-x-0 bottom-0 p-3.5">
                  <p class="text-white font-bold text-[17px] leading-snug line-clamp-2">{item.description}</p>
                </div>
              </div>
              <!-- 下方信息行：图标 + 名称 + 类型 + 查看 -->
              <div class="p-3 flex items-center gap-3">
                <div class="w-10 h-10 rounded-[11px] overflow-hidden flex-none bg-black/10 dark:bg-white/5">
                  {item.cover && (
                    <img src={item.cover} alt="" class="w-full h-full object-cover" loading="lazy" />
                  )}
                </div>
                <div class="min-w-0 flex-1">
                  <div class="font-semibold text-[14px] text-90 truncate">{item.title}</div>
                  <div class="text-[11.5px] text-75 mt-0.5 truncate">
                    {isProj ? (item.type === "game" ? "游戏" : "软件") : "视频"} · 精选
                  </div>
                </div>
                <span class="flex-none px-3.5 py-1.5 rounded-full bg-[var(--primary)] text-white text-[12px] font-semibold">
                  查看
                </span>
              </div>
            </a>
          );
        })}
      </div>
      {featuredItems.length > 1 && (
        <div class="md:hidden flex items-center justify-center gap-1.5 pt-3">
          {featuredItems.map((_, i) => (
            <span class="mcar-dot" data-mcar-dot={i} data-active={i === 0 ? "1" : "0"}></span>
          ))}
        </div>
      )}
    </div>
  )}

  <!-- ==================================================== -->
  <!-- ② 主舞台 + 侧边栏                                     -->
  <!-- 移动端顺序：故事 → 推荐 → 新闻 → 文章                   -->
  <!-- 桌面端顺序：文章（左 7 列）｜ 故事+推荐+新闻（右 5 列）  -->
  <!-- ==================================================== -->
  <div class="flex flex-col gap-8 max-md:gap-6 lg:grid lg:grid-cols-12 lg:gap-5 mb-8 max-md:mb-6">

    <!-- ============ 右栏（DOM 在前 · 移动端优先显示） ============ -->
    <div class="lg:col-span-5 order-1 lg:order-2 flex flex-col gap-8 max-md:gap-6 lg:gap-5">

      <!-- 那些故事 -->
      {novels.length > 0 && (
        <div>
          <div class="flex items-center justify-between mb-5 max-md:mb-3">
            <h2 class="text-lg font-bold text-90 flex items-center gap-2">
              <Icon name="material-symbols:auto-stories-rounded" class="text-[var(--primary)] text-[1.25rem]" />
              那些故事
            </h2>
            <a href="/novels/" class="text-sm font-medium text-[var(--primary)] hover:underline flex items-center gap-1">
              查看全部
              <Icon name="material-symbols:chevron-right-rounded" class="text-[1rem]" />
            </a>
          </div>
          <div class="flex gap-3 overflow-x-auto pb-2 max-md:grid max-md:grid-cols-1 max-md:gap-2.5 max-md:overflow-visible max-md:pb-0 lg:grid lg:grid-cols-2 lg:overflow-visible lg:pb-0" style="scrollbar-width: thin;">
            {novels.slice(0, 4).map((n) => (
              <a
                href={`/novels/${n.id}/`}
                class="card-base group rounded-[var(--radius-large)] overflow-hidden
                       hover:scale-[1.02] active:scale-100 transition-transform duration-200
                       flex-shrink-0 w-[140px] max-md:w-auto max-md:flex-shrink max-md:flex max-md:flex-row max-md:items-center max-md:gap-3 max-md:p-2.5 max-md:hover:scale-100 lg:w-auto"
              >
                <div class="aspect-[3/4] w-full overflow-hidden bg-black/10 dark:bg-white/5 max-md:w-[54px] max-md:flex-none max-md:rounded-[10px]">
                  <img
                    src={n.cover}
                    alt={n.title}
                    class="w-full h-full object-cover transition group-hover:scale-105 duration-300"
                    loading="lazy"
                  />
                </div>
                <div class="p-3 max-md:p-0 max-md:min-w-0 max-md:flex-1">
                  <h3 class="font-bold text-sm text-90 group-hover:text-[var(--primary)] transition-colors truncate">
                    {n.title}
                  </h3>
                  <p class="text-xs text-75 mt-1 line-clamp-2 leading-relaxed">
                    {n.description}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- 我的兴趣（分区墙，链接到 /interests/） -->
      {interestSections.length > 0 && (
        <div>
          <div class="flex items-center justify-between mb-5 max-md:mb-3">
            <h2 class="text-lg font-bold text-90 flex items-center gap-2">
              <Icon name="material-symbols:favorite-outline-rounded" class="text-[var(--primary)] text-[1.25rem]" />
              我的兴趣
            </h2>
            <a href="/interests/" class="text-sm font-medium text-[var(--primary)] hover:underline flex items-center gap-1">
              查看全部
              <Icon name="material-symbols:chevron-right-rounded" class="text-[1rem]" />
            </a>
          </div>
          <div class="flex gap-3 overflow-x-auto pb-2" style="scrollbar-width: thin;">
            {interestSections.slice(0, 8).map((sec) => (
              <a
                href={`/interests/${sec.id}/`}
                class="card-base group rounded-[var(--radius-large)] overflow-hidden
                       hover:scale-[1.02] active:scale-100 transition-transform duration-200
                       flex-shrink-0 w-[150px]"
              >
                <div class="aspect-[16/10] w-full overflow-hidden bg-black/10 dark:bg-white/10">
                  {sec.cover ? (
                    <img src={sec.cover} alt={sec.name} class="w-full h-full object-cover transition group-hover:scale-105 duration-300" loading="lazy" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-[var(--primary)]/40">
                      <Icon name={INTEREST_TYPE_META[sec.type].icon} class="text-3xl" />
                    </div>
                  )}
                </div>
                <div class="p-2.5">
                  <div class="flex items-center gap-1 text-[10.5px] text-[var(--primary)] mb-0.5">
                    <Icon name={INTEREST_TYPE_META[sec.type].icon} class="text-[0.9rem]" />
                    {INTEREST_TYPE_META[sec.type].label}
                  </div>
                  <h3 class="font-semibold text-[13px] text-90 truncate group-hover:text-[var(--primary)] transition-colors">
                    {sec.name}
                  </h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- 今日推荐 -->
      {resources.length > 0 && (
        <div>
          <div class="flex items-center justify-between mb-5 max-md:mb-3">
            <h2 class="text-lg font-bold text-90 flex items-center gap-2">
              <Icon name="material-symbols:package-outline-rounded" class="text-[var(--primary)] text-[1.25rem]" />
              今日推荐
            </h2>
            <a href="/appstore/" class="text-sm font-medium text-[var(--primary)] hover:underline flex items-center gap-1">
              查看全部
              <Icon name="material-symbols:chevron-right-rounded" class="text-[1rem]" />
            </a>
          </div>
          <div class="card-base rounded-[var(--radius-large)] p-3">
            <div class="flex flex-wrap gap-2">
              {resources.slice(0, 8).map((r) => (
                <a
                  href={r.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={r.description}
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full
                         bg-[var(--primary)]/5 hover:bg-[var(--primary)]/10
                         text-xs text-90 transition-colors max-w-full"
                >
                  <Icon name="material-symbols:link-rounded" class="text-[var(--primary)] text-[0.9rem] flex-shrink-0" />
                  <span class="truncate">{r.name}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      )}

      <!-- 新闻（限高 + 内部滚动） -->
      {newsPosts.length > 0 && (
        <div>
          <div class="flex items-center justify-between mb-5 max-md:mb-3">
            <h2 class="text-lg font-bold text-90 flex items-center gap-2">
              <Icon name="material-symbols:newspaper-rounded" class="text-[var(--primary)] text-[1.25rem]" />
              新闻
            </h2>
          </div>
          <div class="card-base rounded-[var(--radius-large)] overflow-hidden">
            <div class="max-h-[320px] max-md:max-h-none overflow-y-auto max-md:overflow-visible" style="scrollbar-width: thin;">
              {newsPosts.map((p) => (
                <a
                  href={getPostUrlBySlug(p.slug)}
                  class="flex items-center justify-between gap-3 px-3 py-2.5 md:px-4 md:py-3
                         hover:bg-[var(--primary)]/5 transition-colors
                         border-b border-black/5 dark:border-white/5 last:border-0"
                >
                  <span class="text-sm text-90 truncate flex-1">{p.data.title}</span>
                  <time class="text-xs text-75 flex-shrink-0 tabular-nums">
                    {formatNewsDate(p.data.published)}
                  </time>
                </a>
              ))}
            </div>
          </div>
        </div>
      )}

    </div>

    <!-- ============ 左栏：我的文章（DOM 在后 · 移动端后显示） ============ -->
    <div class="lg:col-span-7 order-2 lg:order-1 flex flex-col">
      <div class="flex items-center justify-between mb-5 max-md:mb-3">
        <h2 class="text-lg font-bold text-90 flex items-center gap-2">
          <Icon name="material-symbols:article-outline-rounded" class="text-[var(--primary)] text-[1.25rem]" />
          我的文章
        </h2>
        <a href="/posts/" class="text-sm font-medium text-[var(--primary)] hover:underline flex items-center gap-1">
          查看全部
          <Icon name="material-symbols:chevron-right-rounded" class="text-[1rem]" />
        </a>
      </div>

      {latestPosts.length > 0 ? (
        <div class="transition flex flex-col rounded-[var(--radius-large)] bg-[var(--card-bg)] py-1 md:py-0 md:bg-transparent md:gap-4">
          {latestPosts.map((entry) => (
            <PostCard
              entry={entry}
              title={entry.data.title}
              tags={entry.data.tags}
              category={entry.data.category}
              published={entry.data.published}
              updated={entry.data.updated}
              url={getPostUrlBySlug(entry.slug)}
              image={entry.data.image}
              description={entry.data.description}
              draft={entry.data.draft}
              class:list="onload-animation"
              style=""
            />
          ))}
        </div>
      ) : (
        <div class="card-base rounded-[var(--radius-large)] p-8 text-center text-75">
          <Icon name="material-symbols:edit-document-outline-rounded" class="text-4xl mx-auto mb-3 opacity-40" />
          <p>还没有发布文章，敬请期待～</p>
        </div>
      )}
    </div>
  </div>

  <!-- ==================================================== -->
  <!-- ③ 我的日常（桌面 2 列 / 移动端横滑）                    -->
  <!-- ==================================================== -->
  {dailyPosts.length > 0 && (
    <div class="mb-8 max-md:mb-6">
      <div class="flex items-center justify-between mb-5 max-md:mb-3">
        <h2 class="text-lg font-bold text-90 flex items-center gap-2">
          <Icon name="material-symbols:wb-sunny-outline-rounded" class="text-[var(--primary)] text-[1.25rem]" />
          我的日常
        </h2>
        <a href="/daily/" class="text-sm font-medium text-[var(--primary)] hover:underline flex items-center gap-1">
          查看全部
          <Icon name="material-symbols:chevron-right-rounded" class="text-[1rem]" />
        </a>
      </div>
      <div class="flex gap-4 overflow-x-auto pb-3 max-md:flex-col max-md:gap-3 max-md:overflow-visible max-md:pb-0 md:grid md:grid-cols-2 md:overflow-visible md:pb-0" style="scrollbar-width: thin;">
        {dailyPosts.map((entry) => (
          <div class="flex-shrink-0 w-[85vw] max-md:w-full md:w-auto">
            <PostCard
              entry={entry}
              title={entry.data.title}
              tags={entry.data.tags}
              category={entry.data.category}
              published={entry.data.published}
              updated={entry.data.updated}
              url={getPostUrlBySlug(entry.slug)}
              image={entry.data.image}
              description={entry.data.description}
              draft={entry.data.draft}
              class:list="onload-animation"
              style=""
            />
          </div>
        ))}
      </div>
    </div>
  )}

</MainGridLayout>

<!-- ==================== 首页「猜你喜欢」轮播样式（仅桌面端） ==================== -->
<style>
  .feat-stage {
    aspect-ratio: 16 / 9;
  }
  .feat-slide {
    position: absolute;
    inset: 0;
    display: none;
  }
  .feat-slide[data-active="1"] {
    display: block;
    animation: featIn 0.5s ease;
  }
  @keyframes featIn {
    from {
      opacity: 0.35;
    }
    to {
      opacity: 1;
    }
  }
  .feat-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .feat-slide:hover .feat-cover {
    transform: scale(1.03);
  }
  .feat-nav {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.38);
    border: none;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: background 0.15s ease;
  }
  .feat-nav:hover {
    background: rgba(0, 0, 0, 0.62);
  }
  .feat-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .feat-dot[data-active="1"] {
    width: 22px;
    background: #fff;
  }
  .feat-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px;
    border-radius: 14px;
    border: 1px solid transparent;
    background: var(--card-bg);
    text-align: left;
    cursor: pointer;
