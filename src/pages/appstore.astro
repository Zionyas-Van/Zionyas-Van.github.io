---
import { Icon } from "astro-icon/components";
import { projects } from "../data/projects";
import { resources } from "../data/resources";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const games = projects.filter((p) => p.type === "game");
const softwares = projects.filter((p) => p.type === "software");

// 资源分类固定顺序，只显示用过的
const RESOURCE_CATEGORY_ORDER = ["网站", "应用", "游戏", "文件", "其他"];
const usedCategories = RESOURCE_CATEGORY_ORDER.filter((c) =>
	resources.some((r) => r.category === c),
);

// 打包数据，交给客户端渲染
const appstoreData = {
	games: games.map((g) => ({
		id: g.id,
		title: g.title,
		description: g.description,
		cover: g.cover,
		// 大图优先用作品截图（方形图标放大当大图会很糊、也不像应用商店）
		shot: (g.screenshots || [])[0] || "",
		featured: g.featured,
		tags: g.tags || [],
	})),
	apps: softwares.map((s) => ({
		id: s.id,
		title: s.title,
		description: s.description,
		cover: s.cover,
		shot: (s.screenshots || [])[0] || "",
		featured: s.featured,
		tags: s.tags || [],
	})),
	resources: resources.map((r) => ({
		id: r.id,
		name: r.name,
		description: r.description,
		url: r.url,
		category: r.category || "未分类",
		cover: r.cover || "",
	})),
	categories: usedCategories,
};
const safeJson = JSON.stringify(appstoreData).replace(/</g, "\\u003c");
---

<MainGridLayout title="应用商店" description="游戏、应用与资源分享">

  <!-- 让 MainGridLayout 隐藏原本的个人侧栏（复用阅读模式机制） -->
  <div id="reader-mode-marker" style="display:none" aria-hidden="true"></div>

  <!-- 数据 -->
  <script type="application/json" id="appstore-data" set:html={safeJson}></script>

  <!-- ================= 顶部：Google Play 式的搜索条 + 分区标签 ================= -->
  <div class="appstore-top">
    <div class="appstore-search">
      <Icon name="material-symbols:search-rounded" class="appstore-search-icon" />
      <input id="appstore-search" type="text" placeholder="搜索应用、游戏和资源" autocomplete="off" />
    </div>

    <nav class="appstore-tabs" aria-label="应用商店分区">
      <button type="button" data-appstore-tab="today" data-active="true">
        <Icon name="material-symbols:today-rounded" class="appstore-tab-icon" />
        <span>Today</span>
      </button>
      <button type="button" data-appstore-tab="games">
        <Icon name="material-symbols:sports-esports-outline-rounded" class="appstore-tab-icon" />
        <span>游戏</span>
      </button>
      <button type="button" data-appstore-tab="apps">
        <Icon name="material-symbols:code-blocks-outline-rounded" class="appstore-tab-icon" />
        <span>应用</span>
      </button>
    </nav>
  </div>

  <!-- ================= 主体：左侧分类（Play 的圆角导航）+ 右侧内容 ================= -->
  <div class="appstore-layout">

    <aside class="appstore-sidebar">
      {usedCategories.length > 0 && (
        <div class="appstore-cats">
          <div class="appstore-cats-title">分类</div>
          {usedCategories.map((c) => (
            <button type="button" data-appstore-cat={c}>
              <span>{c}</span>
            </button>
          ))}
        </div>
      )}
    </aside>

    <section class="appstore-main">
      <div id="appstore-content"></div>
    </section>

  </div>
</MainGridLayout>

<style>
  /* ============================================================
     版式参考 Google Play：胶囊搜索条 + 药丸分区标签 + 圆角导航
                      + 「大预览图卡片 / 图标行 + 实心按钮」的内容卡
     ============================================================ */

  /* ---------- 顶部 ---------- */
  .appstore-top {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .appstore-search {
    flex: 1 1 auto;
    max-width: 32rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    height: 48px;
    padding: 0 1.1rem;
    border-radius: 999px;
    border: none;
    background: var(--card-bg);
    box-shadow: 0 1px 2px rgba(16, 15, 25, 0.07), 0 1px 4px rgba(16, 15, 25, 0.05);
    transition: box-shadow 0.15s ease;
  }
  .appstore-search:focus-within {
    box-shadow: 0 2px 8px rgba(16, 15, 25, 0.14),
      0 0 0 2px color-mix(in oklab, var(--primary) 22%, transparent);
  }
  .appstore-search-icon {
    width: 20px;
    height: 20px;
    flex: none;
    opacity: 0.55;
  }
  .appstore-search input {
    flex: 1 1 auto;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    font-size: 15px;
    color: inherit;
  }

  .appstore-tabs {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
  }
  .appstore-tabs button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    height: 42px;
    padding: 0 1.1rem;
    border: none;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--content-meta, #6b7280);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .appstore-tabs button:hover {
    background: color-mix(in oklab, var(--primary) 7%, transparent);
    color: var(--primary);
  }
  .appstore-tabs button[data-active="true"] {
    background: color-mix(in oklab, var(--primary) 13%, transparent);
    color: var(--primary);
  }
  .appstore-tab-icon {
    width: 19px;
    height: 19px;
  }

  /* ---------- 两栏布局 ---------- */
  .appstore-layout {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
  }

  .appstore-sidebar {
    flex: none;
    width: 11rem;
    position: sticky;
    top: 5rem;
  }

  .appstore-cats-title {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--content-meta, #9ca3af);
    padding: 0 0.9rem 0.5rem;
  }

  .appstore-cats {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* Play 左栏：整行圆角、悬停浅底、选中紫底 */
  .appstore-cats button {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    height: 40px;
    padding: 0 0.9rem;
    border: none;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    text-align: left;
    font-size: 14px;
    color: var(--content-meta, #4b5563);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .appstore-cats button:hover {
    background: color-mix(in oklab, var(--primary) 7%, transparent);
    color: var(--primary);
  }
  .appstore-cats button[data-active="true"] {
    background: color-mix(in oklab, var(--primary) 13%, transparent);
    color: var(--primary);
    font-weight: 600;
  }

  .appstore-main {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* ---------- 顶部横向标签（Play 的药丸 chips） ---------- */
  .appstore-tag {
    border: none;
    cursor: pointer;
    background: color-mix(in oklab, var(--primary) 6%, var(--card-bg));
    color: var(--content-meta, #6b7280);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .appstore-tag:hover {
    background: color-mix(in oklab, var(--primary) 12%, var(--card-bg));
    color: var(--primary);
  }
  .appstore-tag[data-active="true"] {
    background: var(--primary);
    color: #fff;
  }

  /* ---------- 手机端：Play 的紧凑版式 ---------- */
  @media (max-width: 767px) {
    .appstore-top {
      flex-direction: column;
      align-items: stretch;
      gap: 0.7rem;
      margin-bottom: 1rem;
    }
    .appstore-search {
      max-width: none;
      height: 46px;
    }
    /* 字号 ≥16px：iOS 对小于 16px 的输入框会自动放大整页 */
    .appstore-search input {
      font-size: 16px;
    }
    /* 三个分区：分段控件（三等分、选中项浮起） */
    .appstore-tabs {
      gap: 4px;
      padding: 4px;
      border-radius: 999px;
      background: color-mix(in oklab, var(--primary) 6%, rgba(128, 128, 128, 0.1));
    }
    .appstore-tabs button {
      flex: 1 1 0;
      height: 38px;
      padding: 0 0.4rem;
      border-radius: 999px;
      font-size: 13.5px;
    }
    .appstore-tabs button[data-active="true"] {
      background: var(--card-bg);
      box-shadow: 0 1px 2px rgba(16, 15, 25, 0.1);
    }

    .appstore-layout {
      flex-direction: column;
      /* 必须 stretch：column 方向的 flex-start 会让内容列按"内容宽度"撑开
         （横滑推荐区有 1000px+ 宽），结果整页被拉宽、手机上看不全 */
      align-items: stretch;
      gap: 0.8rem;
    }
    .appstore-sidebar {
      width: 100%;
      position: static;
      margin-bottom: 0.25rem;
    }
    /* 分类在手机上变成横向滚动的 chips，去掉小标题 */
    .appstore-cats-title {
      display: none;
    }
    .appstore-cats {
      flex-direction: row;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 2px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .appstore-cats::-webkit-scrollbar {
      display: none;
    }
    .appstore-cats button {
      flex: none;
      height: 36px;
      padding: 0 14px;
      border-radius: 999px;
      font-size: 13px;
      border: 1px solid rgba(128, 128, 128, 0.22);
    }
    .appstore-cats button[data-active="true"] {
      background: color-mix(in oklab, var(--primary) 12%, transparent);
      border-color: color-mix(in oklab, var(--primary) 55%, transparent);
    }
  }
</style>
