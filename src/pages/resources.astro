---
import { Icon } from "astro-icon/components";
import { resources } from "../data/resources";
// ============================================
// 资源分享 · 全部资源
// ============================================
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout title="资源分享" description="实用资源与工具推荐">
  <div class="mb-6 onload-animation">
    <h1 class="text-2xl font-bold text-90 flex items-center gap-2">
      <Icon name="material-symbols:package-outline-rounded" class="text-[var(--primary)] text-[1.75rem]" />
      资源分享
    </h1>
    <p class="text-75 mt-1.5 text-sm">实用资源与工具推荐</p>
  </div>

  <!-- 搜索框 -->
  <div class="mb-4 onload-animation">
    <div class="card-base rounded-[var(--radius-large)] flex items-center gap-2.5 px-4 py-2.5">
      <Icon name="material-symbols:search-rounded" class="text-75 text-[1.25rem] flex-shrink-0" />
      <input
        id="resource-search"
        type="text"
        placeholder="搜索资源名称或描述…"
        autocomplete="off"
        class="bg-transparent outline-none w-full text-90 placeholder:text-50 text-sm"
      />
    </div>
  </div>

  {resources.length > 0 ? (
    <>
      <div id="resource-grid" class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {resources.map((r) => (
          <a
            href={r.url}
            target="_blank"
            rel="noopener noreferrer"
            data-resource-card
            data-search={`${r.name} ${r.description}`.toLowerCase()}
            class="card-base group rounded-[var(--radius-large)] p-5
                   hover:scale-[1.01] active:scale-100 transition-transform duration-200
                   flex items-start gap-3 onload-animation"
          >
            <div class="w-10 h-10 rounded-lg bg-[var(--primary)]/10 flex items-center justify-center flex-shrink-0">
              <Icon name="material-symbols:link-rounded" class="text-[var(--primary)] text-[1.25rem]" />
            </div>
            <div class="min-w-0">
              <h3 class="font-semibold text-90 group-hover:text-[var(--primary)] transition-colors">
                {r.name}
              </h3>
              <p class="text-sm text-75 mt-1 leading-relaxed">
                {r.description}
              </p>
            </div>
          </a>
        ))}
      </div>

      <div
        id="resource-search-empty"
        style="display: none;"
        class="card-base rounded-[var(--radius-large)] p-12 text-center text-75 onload-animation"
      >
        <Icon name="material-symbols:search-off-rounded" class="text-6xl mx-auto mb-4 opacity-25" />
        <p class="font-medium text-lg text-90 mb-2">没有找到匹配的资源</p>
        <p class="text-sm">换个关键词试试～</p>
      </div>
    </>
  ) : (
    <div class="card-base rounded-[var(--radius-large)] p-12 text-center text-75 onload-animation">
      <Icon name="material-symbols:package-outline-rounded" class="text-6xl mx-auto mb-4 opacity-25" />
      <p class="font-medium text-lg text-90 mb-2">暂无资源</p>
      <p class="text-sm">还没有分享任何资源，敬请期待～</p>
    </div>
  )}
</MainGridLayout>

<script>
  function initResourceSearch() {
    const input = document.getElementById("resource-search");
    const grid = document.getElementById("resource-grid");
    if (!input || !grid || input.dataset.bound === "1") return;
    input.dataset.bound = "1";

    const empty = document.getElementById("resource-search-empty");
    const cards = Array.from(grid.querySelectorAll("[data-resource-card]"));

    const apply = () => {
      const q = input.value.trim().toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const hit = !q || (card.dataset.search || "").includes(q);
        card.style.display = hit ? "" : "none";
        if (hit) visible++;
      }
      if (empty) empty.style.display = visible === 0 && q ? "" : "none";
    };

    input.addEventListener("input", apply);
  }

  initResourceSearch();
  ["page:view", "swup:page:view", "astro:page-load"].forEach((evt) => {
    document.addEventListener(evt, initResourceSearch);
  });
</script>