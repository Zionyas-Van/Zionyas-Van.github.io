---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import MobileBottomNav from "@components/MobileBottomNav.astro";
import MobileNavChips from "@components/MobileNavChips.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
} = Astro.props;
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="z-50 pointer-events-none relative transition-all duration-700 max-w-[var(--page-width)] px-0 md:px-4 mx-auto" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all">
        <Navbar></Navbar>
    </div>
</div>

<!-- Banner -->
{siteConfig.banner.enable && <div id="banner-wrapper" class={`absolute z-10 w-full transition duration-700 overflow-hidden`} style={`top: -${BANNER_HEIGHT_EXTEND}vh`}>
    <ImageWrapper id="banner" alt="Banner image of the blog" class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
                  src={siteConfig.banner.src} position={siteConfig.banner.position}
    >
    </ImageWrapper>
</div>}

<!-- Main content -->
<div id="main-panel" class="absolute w-full z-30 pointer-events-none" style={`top: ${mainPanelTop}`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
        <div id="main-grid" class="transition duration-700 w-full left-0 right-0 grid grid-cols-[17.5rem_auto] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto]
    mx-auto gap-4 px-2 md:px-4"
        >
            <!-- Banner image credit -->
            {hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
                                   class:list={["group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                                   "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
            >
                <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa6-solid:arrow-up-right-from-square">
                </Icon>
            </a>}


            <SideBar class="mb-4 row-start-2 row-end-3 col-span-2 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-[17.5rem] onload-animation" headings={headings}></SideBar>

            <main id="swup-container" class="transition-swup-fade col-span-2 lg:col-span-1 overflow-hidden">
                <!-- 手机端：Google Play 式的大圆角分类筛选栏（桌面端隐藏） -->
                <MobileNavChips />
                <div id="content-wrapper" class="onload-animation">
                    <!-- the overflow-hidden here prevent long text break the layout-->
                    <!-- make id different from windows.swup global property -->
                    <div class="px-2 md:px-0" data-pagefind-body>
                      <slot></slot>
                    </div>
                    <div class="footer col-span-2 onload-animation hidden lg:block">
                        <Footer></Footer>
                    </div>
                </div>
            </main>

            <div class="footer col-span-2 onload-animation block lg:hidden">
                <Footer></Footer>
            </div>
        </div>

        <!-- 图片放大预览（点带 data-zoom 的图片打开，点任意处/×/返回键关闭） -->
        <div id="img-lightbox" aria-hidden="true">
          <button type="button" class="lb-close" data-lb-close aria-label="关闭图片预览">
            <Icon name="material-symbols:close-rounded" class="text-[1.4rem]" />
          </button>
          <img id="img-lightbox-img" alt="" />
        </div>

        <!-- 兴趣帖子全文预览（点带 data-preview 的卡片打开，样式对齐博客文章页） -->
        <div id="post-preview" aria-hidden="true">
          <div class="pp-mask" data-pp-close></div>
          <div class="pp-panel" role="dialog" aria-modal="true" aria-labelledby="pp-title">
            <div class="pp-head">
              <div class="min-w-0">
                <h2 id="pp-title"></h2>
                <div id="pp-meta" class="pp-meta"></div>
              </div>
              <button type="button" class="pp-close" data-pp-close aria-label="关闭预览">
                <Icon name="material-symbols:close-rounded" class="text-[1.2rem]" />
              </button>
            </div>
            <div id="pp-body" class="pp-body ip-body"></div>
            <div class="pp-foot">
              <a id="pp-section" href="/interests/">查看所在分区 →</a>
            </div>
          </div>
        </div>

        <!-- 移动端底部导航栏（全站，放在 main 之外，切页不丢、刷新也在） -->
        <MobileBottomNav />

        <BackToTop></BackToTop>
    </div>
</div>

<!-- The things that should be under the banner, only the TOC for now -->
<div class="absolute w-full z-0 hidden 2xl:block">
    <div class="relative max-w-[var(--page-width)] mx-auto">
        <!-- TOC component -->
        {siteConfig.toc.enable && <div id="toc-wrapper" class:list={["hidden lg:block transition absolute top-0 -right-[var(--toc-width)] w-[var(--toc-width)] items-center",
            {"toc-hide": siteConfig.banner.enable}]}
        >
            <div id="toc-inner-wrapper" class="fixed top-14 w-[var(--toc-width)] h-[calc(100vh_-_20rem)] overflow-y-scroll overflow-x-hidden hide-scrollbar">
                <div id="toc" class="w-full h-full transition-swup-fade ">
                    <div class="h-8 w-full"></div>
                    <TOC headings={headings}></TOC>
                    <div class="h-8 w-full"></div>
                </div>
            </div>
        </div>}

        <!-- #toc needs to exist for Swup to work normally -->
        {!siteConfig.toc.enable && <div id="toc"></div>}
    </div>
</div>

<script>
  // ====================================================
  // 全局页面初始化
  // 关键：监听 astro:page-load —— 首次加载和 swup 切页后都会触发
  // ====================================================

  // ---------- ① 阅读模式：隐藏侧边栏 ----------
  function initReaderMode() {
    const isReader = document.getElementById("reader-mode-marker") !== null;
    const mainGrid = document.getElementById("main-grid");
    if (!mainGrid) return;

    const sidebar =
      document.getElementById("main-sidebar") ||
      mainGrid.querySelector(':scope > [class*="lg:max-w-"]') ||
      mainGrid.querySelector(":scope > aside");
    if (!sidebar) return;

    if (isReader) {
      sidebar.style.display = "none";
      mainGrid.style.gridTemplateColumns = "1fr";
    } else {
      sidebar.style.display = "";
      mainGrid.style.gridTemplateColumns = "";
    }
  }

  // ---------- ② 小说列表页：三榜单渲染 ----------
  // ---------- ② 小说页（/novels/）：筛选 + 排序 + 列表重绘 ----------
  function initNovelsPage() {
    const dataEl = document.getElementById("novels-data");
    const listEl = document.getElementById("novel-list");
    const filterEl = document.querySelector("[data-novel-filterbar]");
    if (!dataEl || !listEl || !filterEl) return;
    if (listEl.dataset.wired === "1") return;
    listEl.dataset.wired = "1";

    let data;
    try {
      data = JSON.parse(dataEl.textContent || "[]");
    } catch {
      return;
    }
    if (!Array.isArray(data) || data.length === 0) return;

    const countEl = document.getElementById("novel-list-count");
    const emptyEl = document.getElementById("novel-list-empty");
    const searchEl = document.getElementById("novel-search");

    const esc = (s) =>
      String(s == null ? "" : s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");

    const fmtWords = (w) =>
      w >= 10000 ? `${(w / 10000).toFixed(1).replace(/\.0$/, "")} 万字` : `${w} 字`;

    const state = { platform: "全部", length: "全部", sort: "latest", q: "" };

    const inLength = (n, key) => {
      if (key === "短篇") return n.words < 100000;
      if (key === "中篇") return n.words >= 100000 && n.words < 500000;
      if (key === "长篇") return n.words >= 500000;
      return true;
    };

    const sorters = {
      latest: (a, b) => String(b.latest || "").localeCompare(String(a.latest || "")),
      words: (a, b) => b.words - a.words,
      chapters: (a, b) => b.chapterCount - a.chapterCount,
      title: (a, b) => String(a.title || "").localeCompare(String(b.title || ""), "zh-Hans-CN"),
    };

    // 注意：这段结构必须和 novels.astro 里服务端渲染的列表行保持一致
    // （手机端是 Google Play 图书式封面两列，电脑端仍是原来的横向列表行）
    const rowHtml = (n) => `
      <a href="/novels/${esc(n.id)}/"
         data-tilt
         class="card-base group rounded-[18px] p-3 flex flex-col md:flex-row gap-3.5 max-md:gap-2 hover:shadow-[0_6px_18px_rgba(18,16,32,0.10)] transition-all">
        <div class="w-full md:w-[86px] aspect-[3/4] flex-none rounded-xl overflow-hidden bg-black/10 dark:bg-white/5">
          ${n.cover ? `<img src="${esc(n.cover)}" alt="${esc(n.title)}" class="w-full h-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />` : ""}
        </div>
        <div class="min-w-0 flex-1 flex flex-col">
          <h3 class="font-bold text-[15px] max-md:text-[13px] max-md:leading-snug text-90 group-hover:text-[var(--primary)] transition-colors line-clamp-2 md:line-clamp-1">${esc(n.title)}</h3>
          <div class="flex items-center gap-2 flex-wrap mt-1.5 max-md:mt-1 text-[11.5px] max-md:text-[11px] text-75">
            <span class="truncate">${esc(n.author || "佚名")}</span>
            ${n.platform ? `<span class="px-1.5 py-0.5 rounded-md bg-[var(--primary)]/10 text-[var(--primary)] max-md:hidden">${esc(n.platform)}</span>` : ""}
            <span class="text-75/60">共 ${n.chapterCount} 章<span class="max-md:hidden"> · ${fmtWords(n.words)}</span></span>
          </div>
          <p class="text-[12.5px] text-75/80 mt-1.5 line-clamp-2 leading-relaxed max-md:hidden">${esc(n.description)}</p>
          <div class="mt-auto pt-1.5 text-[11px] text-75/55 max-md:hidden">最近更新：${esc(n.latest || "—")}</div>
        </div>
      </a>`;

    const apply = () => {
      const q = state.q.trim().toLowerCase();
      const items = data.filter(
        (n) =>
          (state.platform === "全部" || n.platform === state.platform) &&
          inLength(n, state.length) &&
          (!q || `${n.title} ${n.author}`.toLowerCase().includes(q)),
      );
      items.sort(sorters[state.sort] || sorters.latest);
      listEl.innerHTML = items.map(rowHtml).join("");
      if (countEl) countEl.textContent = `共 ${items.length} 部`;
      if (emptyEl) emptyEl.classList.toggle("hidden", items.length > 0);
    };

    const chips = Array.from(filterEl.querySelectorAll("[data-novel-filter]"));
    chips.forEach((chip) => {
      if (chip.dataset.bound === "1") return;
      chip.dataset.bound = "1";
      chip.addEventListener("click", () => {
        const group = chip.dataset.novelFilter;
        const value = chip.dataset.novelValue || "全部";
        if (group === "sort") state.sort = value;
        else if (group === "platform") state.platform = value;
        else if (group === "length") state.length = value;
        chips
          .filter((c) => c.dataset.novelFilter === group)
          .forEach((c) => (c.dataset.active = c === chip ? "true" : "false"));
        apply();
      });
    });

    if (searchEl && searchEl.dataset.bound !== "1") {
      searchEl.dataset.bound = "1";
      searchEl.addEventListener("input", () => {
        state.q = searchEl.value || "";
        apply();
      });
    }
  }

  // ---------- ③ 应用商店页（/appstore/）----------
  function initAppstore() {
    const dataEl = document.getElementById("appstore-data");
    const contentEl = document.getElementById("appstore-content");
    const pageEl = document.querySelector(".appstore-top") || document;
    const searchEl = document.getElementById("appstore-search");
    if (!dataEl || !contentEl) return;

    let data;
    try {
      data = JSON.parse(dataEl.textContent || "{}");
    } catch { return; }
    if (!data || !Array.isArray(data.games)) return;

    // 分区标签现在是页面顶部的药丸标签（已不在侧栏里），所以在整页范围里找
    const tabBtns = Array.from(pageEl.querySelectorAll("[data-appstore-tab]"));
    const catBtns = Array.from(document.querySelectorAll("[data-appstore-cat]"));

    const state = { tab: "today", cat: null, tag: null, query: "" };

    const esc = (s) =>
      String(s || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");

    // ===== 精选大卡：两端共用一套 Play 卡片语言，只是尺寸不同 =====
    const renderBanner = (item) => {
      if (!item) return "";
      const isRes = item._kind === "resource";
      const href = isRes ? item.url : `/projects/${item.id}/`;
      const title = item.title || item.name;
      const desc = item.description || "";
      const cover = item.cover || "";
      const preview = item.shot || cover;
      const linkAttr = isRes ? 'target="_blank" rel="noopener noreferrer"' : "";
      return `
        <a href="${esc(href)}" ${linkAttr} data-tilt
           class="card-base group block rounded-[20px] md:rounded-[24px] overflow-hidden mb-5 md:mb-7 active:scale-[0.99] transition">
          <div class="aspect-[16/9] md:aspect-[21/9] w-full overflow-hidden bg-black/10 dark:bg-white/5">
            ${preview ? `<img src="${esc(preview)}" alt="${esc(title)}" class="w-full h-full object-cover transition duration-500 group-hover:scale-[1.02]" />` : ""}
          </div>
          <div class="p-3.5 md:p-5 flex items-center gap-3 md:gap-4">
            <div class="w-12 h-12 md:w-14 md:h-14 rounded-[14px] md:rounded-2xl overflow-hidden flex-shrink-0 bg-black/10 dark:bg-white/5">
              ${cover ? `<img src="${esc(cover)}" alt="" class="w-full h-full object-cover" loading="lazy" />` : ""}
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-[10.5px] md:text-[11px] font-bold tracking-wide text-[var(--primary)] mb-0.5 md:mb-1">精选推荐</div>
              <h2 class="font-bold text-[16px] md:text-[20px] leading-snug text-90 truncate">${esc(title)}</h2>
              <p class="text-[12px] md:text-[13px] text-75 mt-0.5 md:mt-1 line-clamp-1 md:line-clamp-2">${esc(desc)}</p>
            </div>
            <span class="flex-shrink-0 px-3.5 py-1.5 md:px-5 md:py-2 rounded-full bg-[var(--primary)] text-white text-[12.5px] md:text-sm font-semibold">查看</span>
          </div>
        </a>`;
    };

    // ===== 内容卡片：桌面端=带大预览图的 Play 卡片；手机端=紧凑图标行 =====
    const renderListCard = (item) => {
      const isRes = item._kind === "resource";
      const href = isRes ? item.url : `/projects/${item.id}/`;
      const title = item.title || item.name;
      const cover = item.cover || "";
      const previewSrc = item.shot || cover;
      const preview = previewSrc
        ? `<img src="${esc(previewSrc)}" alt="" class="w-full h-full object-cover transition duration-500 group-hover:scale-[1.03]" loading="lazy" />`
        : `<div class="w-full h-full bg-gradient-to-br from-[var(--primary)]/18 to-[var(--primary)]/5"></div>`;
      return `
        <a href="${esc(href)}" ${isRes ? 'target="_blank" rel="noopener noreferrer"' : ""} data-tilt
           class="card-base group block rounded-[18px] md:rounded-[22px] overflow-hidden
                  hover:shadow-[0_6px_18px_rgba(18,16,32,0.10)] active:scale-[0.99] transition-all">
          <div class="hidden md:block aspect-[16/10] w-full overflow-hidden bg-black/10 dark:bg-white/5">
            ${preview}
          </div>
          <div class="p-3.5 md:p-4 flex items-center gap-3.5">
            <div class="w-14 h-14 md:w-12 md:h-12 rounded-[14px] md:rounded-xl overflow-hidden flex-shrink-0
                        flex items-center justify-center"
                 style="${cover ? "" : "background: color-mix(in oklab, var(--primary) 14%, transparent)"}">
              ${
                cover
                  ? `<img src="${esc(cover)}" alt="${esc(title)}" class="w-full h-full object-cover" loading="lazy" />`
                  : `<span class="font-bold text-[18px]" style="color: var(--primary); opacity: .6">${esc((title || "?").slice(0, 1))}</span>`
              }
            </div>
            <div class="min-w-0 flex-1">
              <h3 class="font-semibold text-[15px] md:text-sm text-90 group-hover:text-[var(--primary)] transition-colors truncate">
                ${esc(title)}
              </h3>
              <p class="text-[12.5px] md:text-xs text-75/70 mt-0.5 truncate">
                ${esc(item.description || "")}
              </p>
            </div>
            <span class="flex-shrink-0 px-3.5 py-1.5 rounded-full bg-[var(--primary)] text-white text-[12.5px] font-semibold">
              查看
            </span>
          </div>
        </a>
      `;
    };

    // ===== 横滑推荐区（Play 的多分区感，两端都显示）=====
    const renderPicks = () => {
      const all = data.resources || [];
      const res = all.slice(0, 8);
      if (res.length === 0) return "";
      return `
        <div class="mt-7 md:mt-9">
          <div class="flex items-baseline justify-between mb-3 md:mb-4">
            <h2 class="text-[17px] md:text-xl font-bold text-90">为你推荐</h2>
            <span class="text-[12px] md:text-[13px] text-75">共 ${all.length} 条</span>
          </div>
          <div class="flex gap-3 md:gap-4 overflow-x-auto pb-2" style="scrollbar-width: none;">
            ${res
              .map(
                (r) => `
              <a href="${esc(r.url)}" target="_blank" rel="noopener noreferrer" data-tilt
                 class="card-base flex-shrink-0 w-[150px] md:w-[178px] rounded-[18px] md:rounded-[20px] overflow-hidden
                        hover:shadow-[0_6px_18px_rgba(18,16,32,0.10)] active:scale-[0.98] transition-all">
                <div class="aspect-[16/10] w-full overflow-hidden relative">
                  ${
                    r.cover
                      ? `<img src="${esc(r.cover)}" alt="" class="w-full h-full object-cover" loading="lazy" />`
                      : `<div class="w-full h-full flex items-center justify-center"
                              style="background: color-mix(in oklab, var(--primary) 14%, transparent)">
                           <span class="font-bold text-[22px]" style="color: var(--primary); opacity: .55">${esc((r.name || "?").slice(0, 1))}</span>
                         </div>`
                  }
                </div>
                <div class="p-2.5 md:p-3">
                  <div class="text-[13px] md:text-sm font-semibold text-90 truncate">${esc(r.name)}</div>
                  <div class="text-[11px] text-75 mt-0.5 truncate">${esc(r.category || "资源")}</div>
                </div>
              </a>`,
              )
              .join("")}
          </div>
        </div>`;
    };

    // ===== 顶部横向标签 =====
    const renderTags = (tags) => {
      if (tags.length === 0) return "";
      const all = ["全部", ...tags];
      return `
                <div class="flex flex-nowrap gap-2 mb-5 max-md:mb-3.5 overflow-x-auto pb-1 -mx-1 px-1">
          ${all.map((t) => {
            const isActive = (t === "全部" && !state.tag) || t === state.tag;
            return `
              <button type="button" data-appstore-tag="${esc(t)}" data-active="${isActive ? "true" : "false"}"
                class="appstore-tag flex-shrink-0 px-3.5 py-1.5 max-md:px-3 max-md:py-1 rounded-full text-xs max-md:text-[12.5px] font-medium whitespace-nowrap">
                ${esc(t)}
              </button>
            `;
          }).join("")}
        </div>
      `;
    };

    const render = () => {
      const q = state.query.trim().toLowerCase();
      let items = [];
      let titleText = "Today";
      let tagsForFilter = [];

      if (state.tab === "games") {
        items = data.games.map((g) => ({ ...g, _kind: "game" }));
        titleText = "游戏";
        const tagSet = new Set();
        items.forEach((it) => (it.tags || []).forEach((t) => tagSet.add(t)));
        tagsForFilter = Array.from(tagSet);
      } else if (state.tab === "apps") {
        items = data.apps.map((a) => ({ ...a, _kind: "app" }));
        titleText = "应用";
        const tagSet = new Set();
        items.forEach((it) => (it.tags || []).forEach((t) => tagSet.add(t)));
        tagsForFilter = Array.from(tagSet);
      } else if (state.tab === "category") {
        items = data.resources
          .filter((r) => r.category === state.cat)
          .map((r) => ({ ...r, _kind: "resource" }));
        titleText = state.cat || "";
      } else {
        items = [
          ...data.games.map((g) => ({ ...g, _kind: "game" })),
          ...data.apps.map((a) => ({ ...a, _kind: "app" })),
        ];
      }

      if (state.tag) {
        items = items.filter((it) => (it.tags || []).includes(state.tag));
      }

      if (q) {
        items = items.filter((it) => {
          const t = (it.title || it.name || "").toLowerCase();
          const d = (it.description || "").toLowerCase();
          return t.includes(q) || d.includes(q);
        });
      }

      const banner =
        !q && items.length > 0
          ? items.find((it) => it.featured) || items[0]
          : null;
      const gridItems = banner ? items.filter((it) => it !== banner) : items;

      contentEl.innerHTML = `
        <div class="mb-4 max-md:mb-3">
          <h1 class="text-2xl max-md:text-[21px] font-bold text-90">${esc(titleText)}</h1>
        </div>
        ${renderTags(tagsForFilter)}
        ${banner ? renderBanner(banner) : ""}
        ${
          gridItems.length > 0
            ? `<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-md:gap-2.5">${gridItems.map(renderListCard).join("")}</div>`
            : `<div class="card-base rounded-[var(--radius-large)] p-12 max-md:p-0 max-md:border-0 max-md:bg-transparent max-md:py-14 text-center text-75">
                 <p class="font-medium text-lg max-md:text-[15px] text-90 mb-2">空空如也</p>
                 <p class="text-sm max-md:text-[12.5px]">换个分类或关键词试试～</p>
               </div>`
        }
        ${state.tab === "today" && !q && !state.tag ? renderPicks() : ""}
      `;

      contentEl.querySelectorAll("[data-appstore-tag]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const t = btn.dataset.appstoreTag;
          state.tag = t === "全部" ? null : t;
          render();
        });
      });
    };

    for (const btn of tabBtns) {
      if (btn.dataset.bound === "1") continue;
      btn.dataset.bound = "1";
      btn.addEventListener("click", () => {
        state.tab = btn.dataset.appstoreTab;
        state.cat = null;
        state.tag = null;
        for (const b of tabBtns) b.dataset.active = b === btn ? "true" : "false";
        for (const b of catBtns) b.dataset.active = "false";
        render();
      });
    }

    for (const btn of catBtns) {
      if (btn.dataset.bound === "1") continue;
      btn.dataset.bound = "1";
      btn.addEventListener("click", () => {
        state.tab = "category";
        state.cat = btn.dataset.appstoreCat;
        state.tag = null;
        for (const b of catBtns) b.dataset.active = b === btn ? "true" : "false";
        for (const b of tabBtns) b.dataset.active = "false";
        render();
      });
    }

    if (searchEl && searchEl.dataset.bound !== "1") {
      searchEl.dataset.bound = "1";
      searchEl.addEventListener("input", () => {
        state.query = searchEl.value;
        render();
      });
    }

    render();
  }

  // ---------- ④ 阅读页工具栏 + 进度条 + 字号 ----------
  function initReaderToolbar() {
    // ① 先在 main（当前页面内容区）里找工具栏：
    //    - swup 切页后，新页面的工具栏一定还在 main 里；
    //    - 同一页被重复触发时，工具栏已被搬到 body 下，main 里找不到。
    const mainEl =
      document.querySelector("main#swup-container") ||
      document.querySelector("main");
    const toolbarInMain = mainEl ? mainEl.querySelector("#reader-toolbar") : null;
    const isReaderPage =
      document.getElementById("reader-mode-marker") !== null;

    if (toolbarInMain) {
      // 当前是阅读页且工具栏还在 main 里 → 清理 body 下遗留的旧工具栏，再搬新的过去
      document.querySelectorAll("body > #reader-toolbar").forEach((el) => el.remove());
      document.body.appendChild(toolbarInMain);
    } else if (!isReaderPage) {
      // 当前不是阅读页 → 清掉任何残留的工具栏，然后结束
      document.querySelectorAll("body > #reader-toolbar").forEach((el) => el.remove());
      return;
    }

    // ② 此时阅读页的工具栏应当在 body 下
    const toolbar = document.querySelector("body > #reader-toolbar");
    if (!toolbar) return;

    // 计算工具栏位置：
    const placeToolbar = () => {
      const tb = document.getElementById("reader-toolbar");
      if (!tb) return;
      const navbar =
        document.querySelector("#navbar-wrapper") ||
        document.querySelector("#top-row") ||
        document.querySelector("header");
      if (navbar) {
        tb.style.top =
          Math.max(0, navbar.getBoundingClientRect().bottom) + "px";
      } else {
        tb.style.top = "64px";
      }
    };

    // 滚动 / 缩放时更新位置。
    // 注意：placeToolbar 里要 getBoundingClientRect（会强制重排），
    // 所以必须每帧最多算一次，否则滚动时每个 scroll 事件都重排一次，低配机直接糊。
    const onScrollRaf = (fn) => {
      let queued = false;
      return () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          fn();
        });
      };
    };
    const placeToolbarRaf = onScrollRaf(placeToolbar);

    // 初次 + 首屏几次测量（处理布局抖动）
    placeToolbar();
    requestAnimationFrame(placeToolbar);
    setTimeout(placeToolbar, 80);
    setTimeout(placeToolbar, 200);

    // 【关键】滚动 / 缩放时持续更新位置
    // 之前只在初始化算了一次，所以滚动后位置不跟着变
    if (window.__readerToolbarPosBound !== true) {
      window.__readerToolbarPosBound = true;
      window.addEventListener("scroll", placeToolbarRaf, { passive: true });
      window.addEventListener("resize", placeToolbarRaf);
    }

    // 进度条
    let bar = document.getElementById("reading-progress");
    if (!bar) {
      bar = document.createElement("div");
      bar.id = "reading-progress";
      bar.style.cssText =
        "position:fixed;top:0;left:0;height:2px;width:0;z-index:60;" +
        "background:var(--primary);transition:width .12s linear;pointer-events:none;";
      document.body.appendChild(bar);
    }
    const updateProgress = () => {
      const h = document.documentElement;
      const top = h.scrollTop || document.body.scrollTop;
      const total = h.scrollHeight - h.clientHeight;
      bar.style.width = (total > 0 ? (top / total) * 100 : 0) + "%";
    };
    const updateProgressRaf = onScrollRaf(updateProgress);
    if (window.__readerProgressBound !== true) {
      window.__readerProgressBound = true;
      window.addEventListener("scroll", updateProgressRaf, { passive: true });
    }
    updateProgress();

    // 字号切换
    const content = document.getElementById("chapter-content");
    const group = document.getElementById("font-size-group");
    if (!content || !group) return;

    const KEY = "novel-font-size";
    const applySize = (size) => {
      content.classList.remove("size-sm", "size-md", "size-lg");
      content.classList.add("size-" + size);
      group.querySelectorAll(".font-size-btn").forEach((b) => {
        b.dataset.active = b.dataset.size === size ? "true" : "false";
      });
      try {
        localStorage.setItem(KEY, size);
      } catch {}
    };

    if (group.dataset.bound !== "1") {
      group.dataset.bound = "1";
      group.querySelectorAll(".font-size-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          applySize(btn.dataset.size || "md");
        });
      });
    }

    let saved = "md";
    try {
      saved = localStorage.getItem(KEY) || "md";
    } catch {}
    applySize(saved);
  }

  // ---------- ⑤ 移动端底部导航：同步当前页面的高亮 ----------
  function initMobileNav() {
    // 分类栏里的「搜索」药丸 → 打开站内搜索面板（手机端顶栏不再放搜索按钮）
    // 用委托 + 一次性绑定：swup 换页会重建这些药丸，但监听器只绑一次
    if (document.body.dataset.chipSearch !== "1") {
      document.body.dataset.chipSearch = "1";
      document.addEventListener("click", (e) => {
        const chip = e.target.closest && e.target.closest("[data-search-chip]");
        if (!chip) return;
        e.preventDefault();
        // 延后一拍再点：否则同一个点击事件会被搜索面板的"点击外部关闭"逻辑接住，
        // 刚打开就又被关掉（实测过）
        setTimeout(() => {
          const btn = document.getElementById("search-switch");
          if (btn) btn.click();
        }, 0);
      });
    }

    const nav = document.getElementById("mobile-bottom-nav");
    if (!nav) return;
    const path = location.pathname;

    nav.querySelectorAll("[data-nav-match]").forEach((item) => {
      // data-nav-match 里可以写多个前缀，用空格分隔（例如「应用」同时匹配 /appstore 和 /projects）
      const matches = (item.dataset.navMatch || "").split(/\s+/).filter(Boolean);
      const active = matches.some((match) =>
        match === "/" ? path === "/" : path === match || path.startsWith(match + "/"),
      );
      item.dataset.active = active ? "true" : "false";
      if (active) {
        item.setAttribute("aria-current", "page");
      } else {
        item.removeAttribute("aria-current");
      }
    });
  }

  // ---------- ⑥ 首页「猜你喜欢」大图轮播 ----------
  function initFeatured() {
    const box = document.querySelector("[data-featured]");
    if (!box) return;
    if (box.dataset.wired === "1") return;
    box.dataset.wired = "1";

    const slides = Array.from(box.querySelectorAll("[data-slide]"));
    const thumbs = Array.from(box.querySelectorAll("[data-feat-thumb]"));
    const dots = Array.from(box.querySelectorAll("[data-feat-dot]"));
    if (slides.length < 2) return;

    const interval = Math.max(3000, Number(box.dataset.interval) || 6000);
    let idx = 0;
    let timer = null;

    const show = (i) => {
      idx = (i + slides.length) % slides.length;
      slides.forEach((el, k) => (el.dataset.active = k === idx ? "1" : "0"));
      thumbs.forEach((el, k) => (el.dataset.active = k === idx ? "1" : "0"));
      dots.forEach((el, k) => (el.dataset.active = k === idx ? "1" : "0"));
    };
    const stop = () => {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    };
    const start = () => {
      stop();
      timer = setInterval(() => {
        // 切走页面时暂停；元素已被 swup 换掉时自动收工，避免残留定时器
        if (document.hidden) return;
        if (!document.body.contains(box)) return stop();
        show(idx + 1);
      }, interval);
    };

    thumbs.forEach((el, k) =>
      el.addEventListener("click", () => {
        show(k);
        start();
      }),
    );
    dots.forEach((el, k) =>
      el.addEventListener("click", () => {
        show(k);
        start();
      }),
    );
    const prev = box.querySelector("[data-feat-prev]");
    const next = box.querySelector("[data-feat-next]");
    if (prev)
      prev.addEventListener("click", () => {
        show(idx - 1);
        start();
      });
    if (next)
      next.addEventListener("click", () => {
        show(idx + 1);
        start();
      });
    box.addEventListener("mouseenter", stop);
    box.addEventListener("mouseleave", start);

    start();
  }

  // ---------- ⑦ 手机端首页轮播（左右滑动 + 自动播放）----------
  function initMobileCarousel() {
    const box = document.querySelector("[data-mcarousel]");
    if (!box) return;
    if (box.dataset.wired === "1") return;
    box.dataset.wired = "1";

    const cards = Array.from(box.querySelectorAll("[data-mcard]"));
    const dots = Array.from(document.querySelectorAll("[data-mcar-dot]"));
    if (cards.length < 2) return;

    const interval = Math.max(3000, Number(box.dataset.interval) || 5000);
    let idx = 0;
    let timer = null;
    let pausedUntil = 0;

    // 把第 i 张卡片滚到"视口正中"（Play 的轮播就是这种居中对齐 + 左右露边）
    const centerCard = (i, smooth) => {
      const card = cards[i];
      if (!card) return;
      const br = box.getBoundingClientRect();
      const cr = card.getBoundingClientRect();
      const delta = cr.left - br.left - (br.width - cr.width) / 2;
      box.scrollTo({ left: box.scrollLeft + delta, behavior: smooth ? "smooth" : "auto" });
    };
    const paintDots = (i) => {
      idx = i;
      dots.forEach((d, k) => (d.dataset.active = k === idx ? "1" : "0"));
    };

    // 用户手动滑动后，根据"最接近中心的卡片"更新圆点
    const syncFromScroll = () => {
      const br = box.getBoundingClientRect();
      const center = br.left + br.width / 2;
      let best = 0;
      let bestD = Infinity;
      cards.forEach((c, k) => {
        const cr = c.getBoundingClientRect();
        const d = Math.abs(cr.left + cr.width / 2 - center);
        if (d < bestD) {
          bestD = d;
          best = k;
        }
      });
      paintDots(best);
    };
    let scrollTimer = null;
    box.addEventListener(
      "scroll",
      () => {
        if (scrollTimer) clearTimeout(scrollTimer);
        scrollTimer = setTimeout(syncFromScroll, 120);
      },
      { passive: true },
    );

    const stop = () => {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    };
    const start = () => {
      stop();
      timer = setInterval(() => {
        if (document.hidden) return;
        if (!document.body.contains(box)) return stop();
        // 用户刚滑过：先让他看一会儿
        if (Date.now() < pausedUntil) return;
        centerCard((idx + 1) % cards.length, true);
      }, interval);
    };

    // 用户一碰就暂停 8 秒，避免"刚滑到想看的那张就被自动带走"
    const onUserTouch = () => {
      pausedUntil = Date.now() + 8000;
    };
    ["touchstart", "pointerdown", "wheel"].forEach((ev) =>
      box.addEventListener(ev, onUserTouch, { passive: true }),
    );
    window.addEventListener("resize", () => centerCard(idx, false));

    centerCard(0, false);
    paintDots(0);
    start();
  }

  // ---------- ⑧ 兴趣页 / 关于页：最爱随机、换一批、类型筛选、搜索 ----------
  function initInterests() {
    // 「最喜欢的 X」并列时随机挑一个（每次打开都可能不同）
    document.querySelectorAll("[data-fav]").forEach((box) => {
      const items = Array.from(box.querySelectorAll("[data-fav-item]"));
      if (items.length <= 1) return;
      const pick = items[Math.floor(Math.random() * items.length)];
      items.forEach((i) => (i === pick ? i.removeAttribute("hidden") : (i.hidden = true)));
    });

    const box = document.getElementById("interest-masonry");
    const filterBar = document.querySelector("[data-interest-filterbar]");
    if (box && filterBar) {
      const cards = Array.from(box.querySelectorAll(".interest-card"));
      const chips = Array.from(filterBar.querySelectorAll("[data-interest-type]"));
      const searchEl = document.getElementById("interest-search");
      const countEl = document.getElementById("interest-count");
      const emptyEl = document.getElementById("interest-empty");
      const state = { type: "all", q: "" };
      const apply = () => {
        const q = state.q.trim().toLowerCase();
        let shown = 0;
        cards.forEach((c) => {
          const ok = (state.type === "all" || c.dataset.type === state.type) && (!q || (c.dataset.name || "").includes(q));
          c.style.display = ok ? "" : "none";
          if (ok) shown++;
        });
        if (countEl) countEl.textContent = `${shown} 个`;
        if (emptyEl) emptyEl.classList.toggle("hidden", shown > 0);
      };
      chips.forEach((chip) => {
        if (chip.dataset.bound === "1") return;
        chip.dataset.bound = "1";
        chip.addEventListener("click", () => {
          state.type = chip.dataset.interestType || "all";
          chips.forEach((c) => (c.dataset.active = c === chip ? "true" : "false"));
          apply();
        });
      });
      if (searchEl && searchEl.dataset.bound !== "1") {
        searchEl.dataset.bound = "1";
        searchEl.addEventListener("input", () => { state.q = searchEl.value || ""; apply(); });
      }
    }

    // 「换一批」：从内嵌 JSON 重新随机 5 条
    const btn = document.getElementById("interest-shuffle");
    const listEl = document.getElementById("interest-random");
    const postsDataEl = document.getElementById("interest-posts");
    const secDataEl = document.getElementById("interest-sections");
    if (!btn || !listEl || !postsDataEl || !secDataEl || btn.dataset.bound === "1") return;
    btn.dataset.bound = "1";
    const posts = JSON.parse(postsDataEl.textContent || "[]");
    const secMap = new Map(JSON.parse(secDataEl.textContent || "[]").map((s) => [s.id, s]));
    const esc = (s) => String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    const fmtMin = (m) => {
      const v = Math.max(0, Math.round(Number(m) || 0));
      if (!v) return "0 分钟";
      const h = Math.floor(v / 60), r = v % 60;
      return h ? (r ? `${h} 小时 ${r} 分` : `${h} 小时`) : `${r} 分钟`;
    };
    const cardHtml = (p) => {
      const s = secMap.get(p.sectionId);
      return `<div role="button" tabindex="0" data-preview="${esc(p.id)}" data-tilt class="card-base rounded-[var(--radius-large)] p-3.5 flex gap-3 cursor-pointer hover:shadow-[0_6px_18px_rgba(18,16,32,0.10)] transition-all">
        <div class="w-11 h-11 rounded-[11px] overflow-hidden flex-none bg-black/10 dark:bg-white/10">${s && s.cover ? `<img src="${esc(s.cover)}" alt="" class="w-full h-full object-cover" loading="lazy">` : ""}</div>
        <div class="min-w-0 flex-1">
          <div class="text-[11px] text-75 mb-0.5 truncate">${esc(s ? s.name : "未分区")}</div>
          <h3 class="font-semibold text-[14px] text-90 truncate">${esc(p.title)}</h3>
          <p class="text-[12px] text-75/75 mt-1 line-clamp-2 leading-relaxed">${esc(p.excerpt)}</p>
          <div class="flex items-center gap-2 mt-1.5 text-[11px] text-75/60">
            ${p.date ? `<span>${esc(p.date)}</span>` : ""}${p.minutes ? `<span>· ${fmtMin(p.minutes)}</span>` : ""}${p.rating ? `<span>· ${p.rating} 分</span>` : ""}
          </div>
        </div></div>`;
    };
    btn.addEventListener("click", () => {
      const pool = [...posts];
      for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j], pool[i]];
      }
      listEl.innerHTML = pool.slice(0, 5).map(cardHtml).join("");
    });
  }

  // ---------- ⑨ 分区页：帖子搜索 + 排序 + 正文限高 ----------
  function initInterestSection() {
    const listEl = document.getElementById("section-posts");
    if (!listEl) return;

    // 正文限高：超过 max-height 的才显示「阅读全部」，短帖子不要多一个按钮
    document.querySelectorAll("[data-clamp]").forEach((box) => {
      const tall = box.scrollHeight > box.clientHeight + 8;
      box.classList.toggle("clamped", tall);
      const btn = box.parentElement && box.parentElement.querySelector("[data-pp-open]");
      if (btn) btn.hidden = !tall;
    });

    // 排序：直接挪 DOM，不重新渲染（图片、弹窗数据都不用重建）
    const parseDate = (raw) => {
      const t = new Date(String(raw || "").replace(/-/g, "/")).getTime();
      return Number.isNaN(t) ? 0 : t;
    };
    const sortBtns = Array.from(document.querySelectorAll("[data-sort]"));
    sortBtns.forEach((btn) => {
      if (btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", () => {
        const dir = btn.dataset.sort === "asc" ? 1 : -1;
        const items = Array.from(listEl.querySelectorAll("[data-post]"));
        items.sort((a, b) => (parseDate(a.dataset.time) - parseDate(b.dataset.time)) * dir);
        items.forEach((el) => listEl.appendChild(el));
        sortBtns.forEach((b) => (b.dataset.active = b === btn ? "true" : "false"));
      });
    });

    const input = document.getElementById("section-post-search");
    if (!input || input.dataset.bound === "1") return;
    input.dataset.bound = "1";
    const posts = Array.from(document.querySelectorAll("[data-post]"));
    const emptyEl = document.getElementById("section-posts-empty");
    input.addEventListener("input", () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      posts.forEach((p) => {
        const ok = !q || (p.dataset.text || "").includes(q);
        p.style.display = ok ? "" : "none";
        if (ok) shown++;
      });
      if (emptyEl) emptyEl.classList.toggle("hidden", shown > 0);
    });
  }

  // ---------- 小说详情页：目录在电脑端展开、手机端收起 ----------
  // 必须放在这里而不是页面自己的 <script> 里：从 /novels/ 点进详情页走的是 swup
  // （只替换 <main>，页面级脚本不会再执行一次），写在页面里会导致电脑端目录也是收起的。
  function initNovelFold() {
    const fold = document.getElementById("novel-chapters");
    if (fold) fold.open = window.matchMedia("(min-width: 768px)").matches;
  }

  // ---------- 统一入口 ----------
  function initAll() {
    initReaderMode();
    initNovelsPage();
    initAppstore();
    initNovelFold();
    initReaderToolbar();
    initMobileNav();
    initFeatured();
    initMobileCarousel();
    /* 阅读页用的是另一套布局：swup 只替换 <main>，混用会残留阅读工具栏、
       并把顶部导航/底部导航永久隐藏。这里做两件事：
       1) 普通页启动时清掉可能残留的阅读页外壳
       2) 给所有「章节」链接打上 data-no-swup，让进出阅读页走整页加载 */
    document.querySelectorAll("#reader-root").forEach((el) => el.remove());
    document.querySelectorAll('a[href^="/novels/"]').forEach((a) => {
      const p = (a.getAttribute("href") || "").replace(/\/$/, "");
      if (p.split("/").filter(Boolean).length >= 3) a.setAttribute("data-no-swup", "");
    });

    initInterests();
    initInterestSection();
    initLightbox();
    initPostPreview();
    initCardLinks();
    initTilt();
    initElapsed();
  }

  // ---------- ⑩ 图片放大预览 ----------
  // 行为：点带 data-zoom 的图 → 铺满屏幕（适应窗口）；再点图片 → 放大到 2 倍，
  // 此时图片超出窗口的部分可以滚轮/手指拖动查看；点图片以外的地方（或 Esc）关闭。
  // 另外每次切页都强制关闭：这个浮层在 <main> 之外，swup 换页不会移除它，
  // 以前"返回上一级图片还挂着"就是这么来的。
  // ponytail: 图片预览用 history.pushState 拿一次「返回」用来关图；只处理这一层，不做多层栈
  let lbPushed = false;
  let lbSuppressPop = false;

  function closeLightbox() {
    const box = document.getElementById("img-lightbox");
    const big = document.getElementById("img-lightbox-img");
    lbPushed = false;
    document.body.classList.remove("lightbox-open");
    if (!box) return;
    box.classList.remove("on", "zoomed");
    box.setAttribute("aria-hidden", "true");
    box.scrollTop = 0;
    box.scrollLeft = 0;
    if (big) {
      big.removeAttribute("src");
      big.style.width = "";
      big.style.maxWidth = "";
      big.style.maxHeight = "";
    }
  }

  function lightboxZoom(on) {
    const box = document.getElementById("img-lightbox");
    const big = document.getElementById("img-lightbox-img");
    if (!box || !big) return;
    if (!on) {
      box.classList.remove("zoomed");
      big.style.width = "";
      big.style.maxWidth = "";
      big.style.maxHeight = "";
      box.scrollTop = 0;
      box.scrollLeft = 0;
      return;
    }
    const w = big.getBoundingClientRect().width || big.naturalWidth;
    if (!w) return;
    big.style.maxWidth = "none";
    big.style.maxHeight = "none";
    big.style.width = `${Math.round(w * 2)}px`;
    box.classList.add("zoomed");
    // 放大后大致对准中间，别让人一上来只看到图片的一个角
    requestAnimationFrame(() => {
      box.scrollLeft = (box.scrollWidth - box.clientWidth) / 2;
      box.scrollTop = (box.scrollHeight - box.clientHeight) / 2;
    });
  }

  function initLightbox() {
    const box = document.getElementById("img-lightbox");
    const big = document.getElementById("img-lightbox-img");
    closeLightbox();
    if (!box || !big) return;
    if (box.dataset.wired === "1") return;
    box.dataset.wired = "1";

    const touchUI = window.matchMedia("(hover: none) and (pointer: coarse)").matches;
    let tapTimer = 0;
    let downY = 0;
    let downX = 0;
    let dragging = false;

    const openLightbox = (src) => {
      big.src = src;
      box.classList.add("on");
      box.classList.remove("zoomed");
      box.setAttribute("aria-hidden", "false");
      // 顶栏的层级比内容区高，不抬一下内容区，放大后的图会钻到顶栏底下
      document.body.classList.add("lightbox-open");
      // 手机系统级返回：先关图，不要直接退出页面
      if (!lbPushed) {
        try {
          history.pushState({ dshLightbox: true }, "");
          lbPushed = true;
        } catch {}
      }
    };

    // 用户主动关闭（X / 点背景 / 下滑）：把刚塞进去的那条历史记录吃掉
    const closeByUser = () => {
      const hadPush = lbPushed;
      closeLightbox();
      if (hadPush) {
        lbSuppressPop = true;
        history.back();
      }
    };

    window.addEventListener(
      "popstate",
      (e) => {
        if (lbSuppressPop) {
          lbSuppressPop = false;
          // 我们自己 history.back() 引起的那一下，别让 swup 当成页面切换
          e.stopImmediatePropagation();
          return;
        }
        if (box.classList.contains("on")) {
          lbPushed = false;
          closeLightbox();
          e.stopImmediatePropagation();
        }
      },
      true,
    );

    document.addEventListener("click", (e) => {
      const t = e.target;
      // 点带 data-zoom 的图片 → 打开
      if (t && t.tagName === "IMG" && t.hasAttribute("data-zoom") && !box.contains(t)) {
        openLightbox(t.currentSrc || t.src);
        return;
      }
      if (!box.classList.contains("on")) return;
      // 右侧 X 按钮 → 关闭
      if (t.closest && t.closest("[data-lb-close]")) {
        closeByUser();
        return;
      }
      if (t === big) {
        if (!touchUI) {
          // 电脑：点图片在适应窗口 / 2 倍之间切换
          lightboxZoom(!box.classList.contains("zoomed"));
          return;
        }
        // 手机：单击关闭（延迟一下，好和双击放大区分开）
        clearTimeout(tapTimer);
        tapTimer = setTimeout(closeByUser, 260);
        return;
      }
      // 点背景 → 关闭
      closeByUser();
    });
    document.addEventListener("dblclick", (e) => {
      if (e.target !== big || !touchUI) return;
      clearTimeout(tapTimer);
      lightboxZoom(!box.classList.contains("zoomed"));
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeByUser();
    });

    // 手机：往下拖 → 关闭（看大图的习惯手势）
    if (touchUI) {
      big.addEventListener(
        "pointerdown",
        (e) => {
          downY = e.clientY;
          downX = e.clientX;
          dragging = true;
          big.style.transition = "none";
        },
        { passive: true },
      );
      big.addEventListener(
        "pointermove",
        (e) => {
          if (!dragging) return;
          const dy = e.clientY - downY;
          const dx = e.clientX - downX;
          if (dy > 0 && Math.abs(dx) < dy) big.style.transform = `translateY(${dy}px) scale(${Math.max(0.7, 1 - dy / 900)})`;
        },
        { passive: true },
      );
      const endDrag = (e) => {
        if (!dragging) return;
        dragging = false;
        const dy = (e && e.clientY) - downY || 0;
        big.style.transition = "";
        big.style.transform = "";
        if (dy > 80) closeByUser();
      };
      big.addEventListener("pointerup", endDrag, { passive: true });
      big.addEventListener("pointercancel", endDrag, { passive: true });
    }
  }

  // ---------- ⑬ 兴趣帖子全文预览（点击卡片弹窗，样式对齐博客文章页） ----------
  // 点击带 data-preview 的卡片 → 从页面里内嵌的 <template data-pid> 取整篇 HTML 塞进弹窗。
  // 正文在构建时已经渲染成 HTML，前端不需要再解析 Markdown。
  function initPostPreview() {
    const box = document.getElementById("post-preview");
    if (!box) return;
    const titleEl = document.getElementById("pp-title");
    const metaEl = document.getElementById("pp-meta");
    const bodyEl = document.getElementById("pp-body");
    const linkEl = document.getElementById("pp-section");
    const close = () => {
      if (!box.classList.contains("on")) return;
      box.classList.remove("on");
      box.setAttribute("aria-hidden", "true");
      if (bodyEl) bodyEl.innerHTML = "";
    };
    // 每次切页都关掉，避免残留（和图片预览同样的坑）
    close();
    if (box.dataset.wired === "1") return;
    box.dataset.wired = "1";

    box.addEventListener("click", (e) => {
      if (e.target.closest("[data-pp-close]")) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        close();
        return;
      }
      // 卡片是 role="button"，键盘回车/空格也能打开
      if (e.key !== "Enter" && e.key !== " ") return;
      const card = e.target.closest ? e.target.closest("[data-preview]") : null;
      if (!card) return;
      e.preventDefault();
      openPreview(card.dataset.preview);
    });

    const openPreview = (id) => {
      const tpl = id ? document.querySelector(`[data-pp-template][data-pid="${id}"]`) : null;
      if (!tpl) return;
      if (titleEl) titleEl.textContent = tpl.dataset.title || "";
      if (metaEl) metaEl.textContent = tpl.dataset.meta || "";
      if (bodyEl) {
        bodyEl.innerHTML = tpl.innerHTML;
        bodyEl.scrollTop = 0;
      }
      if (linkEl) {
        const href = tpl.dataset.section || "";
        linkEl.hidden = !href;
        if (href) linkEl.setAttribute("href", href);
      }
      box.classList.add("on");
      box.setAttribute("aria-hidden", "false");
    };

    document.addEventListener("click", (e) => {
      const card = e.target.closest
        ? e.target.closest("[data-preview], [data-preview-self]")
        : null;
      if (!card) return;
      // 「阅读全部」按钮：即使它是 button 也要放行
      const opener = e.target.closest ? e.target.closest("[data-pp-open]") : null;
      const viaOpener = !!opener && card.contains(opener);
      if (!viaOpener) {
        // 卡片里的真链接、按钮、可放大的图片按自己的逻辑走
        if (e.target.closest("a, button, img[data-zoom]")) return;
        // 拖选文字时不弹窗（方便复制）
        const sel = window.getSelection && String(window.getSelection()).trim();
        if (sel) return;
      }
      e.preventDefault();

      // 分区页里的帖子：正文就在卡片里面，直接拿现成的 HTML，不用另外存一份
      if (card.hasAttribute("data-preview-self")) {
        const md = card.querySelector(".ip-body") || card.querySelector(".custom-md");
        if (titleEl) titleEl.textContent = card.dataset.ppTitle || "";
        if (metaEl) metaEl.textContent = card.dataset.ppMeta || "";
        if (bodyEl) {
          bodyEl.innerHTML = md ? md.innerHTML : "";
          bodyEl.scrollTop = 0;
        }
        if (linkEl) linkEl.hidden = true;
        box.classList.add("on");
        box.setAttribute("aria-hidden", "false");
        return;
      }
      openPreview(card.dataset.preview);
    });
  }

  // ---------- ⑭ 整张卡片可点（博客文章卡） ----------
  // 卡片里还有分类/标签/封面/标题这些真链接，套一层 <a> 会变成嵌套链接（非法），
  // 所以改成点击时判断：没点在内部链接/按钮上、也没在拖选文字，就整张卡跳转。
  // 用 swup.navigate 走站内过渡，别整页刷新。
  function initCardLinks() {
    if (window.__cardLinkWired) return;
    window.__cardLinkWired = 1;
    document.addEventListener("click", (e) => {
      const card = e.target.closest ? e.target.closest("[data-card-href]") : null;
      if (!card) return;
      if (e.defaultPrevented) return;
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      if (e.target.closest("a, button, input, textarea, select, label, [role='button']")) return;
      const sel = window.getSelection && String(window.getSelection()).trim();
      if (sel) return;
      const href = card.dataset.cardHref;
      if (!href) return;
      const swup = window.swup;
      if (swup && typeof swup.navigate === "function") swup.navigate(href);
      else location.href = href;
    });
  }

  // ---------- ⑫ 卡片/按钮 3D 倾斜（桌面悬停）+ 按压缩放（手机） ----------
  // 全站一份：pointermove 事件委托，卡片被筛选/搜索重绘后不用重新绑定。
  // 命中规则：优先带 data-tilt 的卡片（卡片内部的按钮不单独倾斜，避免套娃），
  // 没有卡片再退到按钮/工具栏这些"小零件"上。
  const TILT_SEL =
    "[data-tilt], button, .btn-plain, .btn-card, .btn-regular, .btn-tonal, .pagination, .novel-chip";
  function initTilt() {
    if (window.__tiltWired) return;
    window.__tiltWired = 1;
    // 注意：这里刻意不看 prefers-reduced-motion。
    // 这台机器的 Chrome 就报 reduce（Windows 的"动画效果"关着），
    // 一旦按它降级，站主自己要的倾斜效果会直接看不到。
    // 要改成"系统开减少动态就关掉"，把下面一行取消注释即可：
    // if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    const MAX = 7; // 大卡片的最大倾斜角（度）
    const MAX_SMALL = 4.5; // 按钮/小零件：角度小一点，否则像在抖
    const K = 0.3; // 弹簧系数，越大越跟手
    const FRICTION = 0.72; // 阻尼，越小停得越快
    const states = new Map();
    let raf = 0;
    let pressed = null;

    const tiltTarget = (t) => {
      if (!t || !t.closest) return null;
      const card = t.closest("[data-tilt]");
      if (card) return card;
      return t.closest(TILT_SEL);
    };

    const stateOf = (el) => {
      let s = states.get(el);
      if (!s) {
        s = {
          rx: 0, ry: 0, vx: 0, vy: 0, tx: 0, ty: 0, sc: 1, tsc: 1,
          hot: 0, rect: null, sy: 0, max: MAX, blur: 28, baseY: 12,
          // 上一次真正写进 boxShadow 的角度（NaN = 还没写过，保证第一帧一定写）
          sx: NaN, sy2: NaN,
        };
        states.set(el, s);
      }
      return s;
    };

    // 影子只在角度变化超过 0.45° 时才重写一次：
    // box-shadow 每次变化都要重新光栅化那块区域（还带 28px 模糊），是这套动画里最贵的一笔。
    // 0.45° 对应影子位移不到 1px，肉眼看不出差别，但重绘次数少一大半。
    const writeShadow = (el, s) => {
      if (Math.abs(s.sx - s.rx) < 0.45 && Math.abs(s.sy2 - s.ry) < 0.45) return;
      s.sx = s.rx;
      s.sy2 = s.ry;
      el.style.boxShadow = `${(-s.ry * 2).toFixed(1)}px ${(Math.abs(s.rx) * 1.5 + s.baseY).toFixed(1)}px ${s.blur}px rgba(18,16,32,0.18)`;
    };

    function tick() {
      raf = 0;
      let busy = false;
      const now = performance.now();
      states.forEach((s, el) => {
        // 松手/离开：用固定 160ms 的缓出补间回到平面。
        // 不用 CSS transition，是因为卡片自己的过渡时长不受控（有的 150ms、有的更长），
        // 也不让弹簧慢慢衰减（那样要差不多 1 秒，肉眼像卡了一下）。
        if (s.back) {
          const p = Math.min(1, (now - s.back.t0) / 160);
          const e = 1 - (1 - p) * (1 - p) * (1 - p);
          const rx = s.back.rx0 * (1 - e);
          const ry = s.back.ry0 * (1 - e);
          const sc = 1 + (s.back.sc0 - 1) * (1 - e);
          if (p < 1) {
            s.rx = rx;
            s.ry = ry;
            el.style.transform = `perspective(900px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) scale(${sc.toFixed(3)})`;
            writeShadow(el, s);
            busy = true;
            return;
          }
          el.style.transform = "";
          el.style.boxShadow = "";
          el.style.zIndex = "";
          el.style.position = "";
          el.style.willChange = "";
          states.delete(el);
          if (!states.size) document.documentElement.classList.remove("tilting");
          // 过渡属性要等这一次样式变更落地后再还回去，
          // 否则同一次样式计算里浏览器会拿回卡片自己的 transition，
          // 又从最后角度补一帧过渡（实测多拖了 280ms，看起来像"回位卡一下"）
          setTimeout(() => {
            if (!states.has(el)) el.style.transition = "";
          }, 0);
          return;
        }
        s.vx = (s.vx + (s.tx - s.rx) * K) * FRICTION;
        s.vy = (s.vy + (s.ty - s.ry) * K) * FRICTION;
        s.rx += s.vx;
        s.ry += s.vy;
        s.sc += (s.tsc - s.sc) * 0.24;
        const still =
          Math.abs(s.vx) < 0.02 &&
          Math.abs(s.vy) < 0.02 &&
          Math.abs(s.tx - s.rx) < 0.02 &&
          Math.abs(s.ty - s.ry) < 0.02 &&
          Math.abs(s.tsc - s.sc) < 0.002;
        el.style.transform = `perspective(900px) rotateX(${s.rx.toFixed(2)}deg) rotateY(${s.ry.toFixed(2)}deg) scale(${s.sc.toFixed(3)})`;
        writeShadow(el, s);
        // 还没停就继续下一帧；停住后把循环关掉，但保持当前角度（鼠标还在卡片上）
        if (!still) busy = true;
      });
      if (busy) raf = requestAnimationFrame(tick);
    }
    const run = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    document.addEventListener(
      "pointermove",
      (e) => {
        if (!canHover) return;
        const el = tiltTarget(e.target);
        if (!el) return;
        const s = stateOf(el);
        // 矩形只取一次：卡片已经在倾斜时再量会把倾斜后的形状当基准，角度会抖
        if (!s.rect) {
          s.rect = el.getBoundingClientRect();
          s.sy = window.scrollY;
        }
        const r = s.rect;
        if (!r.width || !r.height) return;
        if (!s.hot) {
          s.hot = 1;
          el.style.transition = "none";
          // 小零件（按钮、胶囊、章节行）用更小的角度和更小的影子，
          // 否则一个 36px 的图标按钮歪 7°、拖着一大片影子，看着像在抖。
          const small = r.width < 200 || r.height < 64;
          s.max = small ? MAX_SMALL : MAX;
          s.blur = small ? 14 : 28;
          s.baseY = small ? 8 : 12;
          // 悬停时把这张卡临时提到最上层：倾斜后会压到相邻卡片/容器的阴影上面去，
          // 不提层级就会被后画的兄弟节点盖住（z-index 只对定位元素生效，所以要加 relative）
          if (canHover) {
            el.style.position = "relative";
            el.style.zIndex = "45";
            // 提前把这张卡提升成独立合成层：之后每帧只改变换矩阵，不用重画卡片内容
            el.style.willChange = "transform";
            // 老浏览器（不认识 overflow-clip-margin）走回退路径，见下面的 CSS
            document.documentElement.classList.add("tilting");
          }
        }
        const px = (e.clientX - r.left) / r.width - 0.5;
        const py = (e.clientY - (r.top - (window.scrollY - s.sy))) / r.height - 0.5;
        s.tx = -py * 2 * s.max;
        s.ty = px * 2 * s.max;
        run();
      },
      { passive: true },
    );

    // 离开/松手：记下当前角度，交给 tick 里的 160ms 缓出补间回位
    const release = (el) => {
      const s = el && states.get(el);
      if (!s) return;
      s.back = { rx0: s.rx, ry0: s.ry, sc0: s.sc, t0: performance.now() };
      s.rect = null;
      run();
    };

    document.addEventListener(
      "pointerout",
      (e) => {
        const el = tiltTarget(e.target);
        if (!el) return;
        if (e.relatedTarget && el.contains(e.relatedTarget)) return;
        release(el);
      },
      { passive: true },
    );

    // 手机端：按下去"弹起"一点（没有倾斜），松手/滑走/取消就收回
    document.addEventListener(
      "pointerdown",
      (e) => {
        if (canHover) return;
        const el = tiltTarget(e.target);
        if (!el) return;
        pressed = el;
        el.style.transition = "none";
        const s = stateOf(el);
        s.rect = null;
        s.tx = 0;
        s.ty = 0;
        s.tsc = 1.035;
        run();
      },
      { passive: true },
    );
    const unpress = () => {
      if (pressed) release(pressed);
      pressed = null;
    };
    for (const ev of ["pointerup", "pointercancel", "dragend"]) {
      document.addEventListener(ev, unpress, { passive: true });
    }
  }

  // ---------- ⑪ 兴趣帖子「已过去 X」实时计算 ----------
  function initElapsed() {
    const els = document.querySelectorAll("[data-elapsed]");
    if (!els.length) return;
    const now = Date.now();
    els.forEach((el) => {
      const host = el.closest("[data-time]");
      const raw = (host && host.dataset.time) || el.dataset.time || "";
      if (!raw) return;
      // Safari 对 2026-9-30 这种写法解析不稳，统一换成斜杠
      const t = new Date(String(raw).replace(/-/g, "/")).getTime();
      if (!t || Number.isNaN(t)) return;
      const diff = now - t;
      if (diff < 0) { el.textContent = "还没到"; return; }
      const mins = Math.floor(diff / 60000);
      const hours = Math.floor(mins / 60);
      const days = Math.floor(hours / 24);
      let txt;
      if (mins < 1) txt = "刚刚";
      else if (mins < 60) txt = `${mins} 分钟`;
      else if (hours < 24) txt = `${hours} 小时`;
      else if (days < 31) txt = `${days} 天`;
      else if (days < 365) txt = `${Math.floor(days / 30)} 个月`;
      else txt = `${(days / 365).toFixed(1).replace(/\.0$/, "")} 年`;
      el.textContent = el.hasAttribute("data-elapsed-plain") ? `${txt}前` : `已过去 ${txt}`;
    });
  }

  // 首次执行 + 每次 swup 切页执行
  initAll();
  ["astro:page-load", "swup:page:view", "page:view"].forEach((evt) => {
    document.addEventListener(evt, initAll);
  });
</script>

<style is:global>
  /* 手机端顶栏只有 4rem，内容区不必留那么大空隙（桌面端仍用布局算出的 top） */
  @media (max-width: 767px) {
    #main-panel {
      top: 4.4rem !important;
    }
  }
  /* 内容列原来用 overflow:hidden 防止超长文本撑破布局，但那样会把卡片倾斜探出去的边角裁掉。
     overflow:clip + clip-margin 可以"只允许溢出 32px"，既保住防溢出，又不用在每次悬停时
     临时切换 overflow（切换会让整列重新布局，是悬停瞬间卡一下的来源）。
     关键：clip 不像 hidden 那样把网格项的"自动最小尺寸"压成 0，
     漏掉 min-width:0 的话这一列会按内容撑到 1288px，手机端整页横向溢出、比例全乱。 */
  main#swup-container {
    min-width: 0;
    overflow: clip;
    overflow-clip-margin: 32px;
  }
  /* 老浏览器不支持 overflow-clip-margin：退回原来的做法，悬停期间临时放开 */
  @supports not (overflow-clip-margin: 1px) {
    html.tilting main#swup-container {
      overflow: visible;
    }
  }

