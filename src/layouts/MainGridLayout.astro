  /* 图片放大预览 */
  /* 预览期间把内容区抬到顶栏之上：顶栏是 z-50，内容区是 z-30，
     不抬的话放大后的图会钻到顶栏下面去 */
  body.lightbox-open #main-panel {
    z-index: 95;
  }
  #img-lightbox {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: rgba(0, 0, 0, 0.86);
    backdrop-filter: blur(4px);
    cursor: zoom-in;
  }
  #img-lightbox.on {
    display: flex;
  }
  /* 右上角关闭按钮：手机上没有它根本不知道该点哪 */
  #img-lightbox .lb-close {
    position: fixed;
    top: calc(env(safe-area-inset-top, 0px) + 12px);
    right: 12px;
    z-index: 2;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  #img-lightbox .lb-close:active {
    background: rgba(255, 255, 255, 0.3);
  }
  #img-lightbox img {
    max-width: 94vw;
    max-height: 90vh;
    border-radius: 12px;
    object-fit: contain;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    cursor: zoom-in;
  }
  /* 放大 2 倍后：容器变成可滚动区域，超出窗口的部分用滚轮/手指拖看 */
  #img-lightbox.on.zoomed {
    display: block;
    padding: 0;
    overflow: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    cursor: zoom-out;
  }
  #img-lightbox.on.zoomed img {
    display: block;
    margin: 0 auto;
    max-width: none;
    max-height: none;
    border-radius: 0;
    box-shadow: none;
    cursor: zoom-out;
  }
