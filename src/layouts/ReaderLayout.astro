---
// ============================================================
// 沉浸式阅读布局（只给小说章节页用）
// 刻意不使用 MainGridLayout：那里有顶栏、侧栏、分类筛选栏、移动端底栏。
// 注意：这里进出阅读页一律整页加载（链接带 data-no-swup），
// 因为 swup 只替换 <main>，两套布局混用会导致组件残留 / 导航被隐藏。
// ============================================================
import { Icon } from "astro-icon/components";
import Layout from "./Layout.astro";

interface Props {
	chapterTitle: string;
	pageTitle: string;
	description?: string;
	novelId: string;
	novelTitle: string;
	chapters: { slug: string; title: string }[];
	currentSlug: string;
	prev?: { slug: string; title: string } | null;
	next?: { slug: string; title: string } | null;
}

const {
	chapterTitle,
	pageTitle,
	description,
	novelId,
	novelTitle,
	chapters,
	currentSlug,
	prev = null,
	next = null,
} = Astro.props;

const base = `/novels/${novelId}/`;
---

<Layout title={pageTitle} description={description}>
	<div id="reader-root">
		<div id="toc" hidden></div>

		<!-- ==================== 顶部工具栏 ==================== -->
		<header id="reader-bar" class="reader-bar">
			<div class="rb-group">
				<a class="rb-btn" href={base} aria-label="返回小说详情" title="返回" data-no-swup>
					<Icon name="material-symbols:arrow-back-rounded" />
				</a>
				<button type="button" class="rb-btn" id="rb-toc" aria-label="目录" title="目录">
					<Icon name="material-symbols:list-rounded" />
					<span>目录</span>
				</button>
			</div>

			<div class="rb-title">{novelTitle}</div>

			<div class="rb-group">
				<div class="rb-font">
					<button type="button" class="rb-step" data-font-step="-1" aria-label="缩小字号">A−</button>
					<input
						id="rb-font"
						type="range"
						min="16"
						max="36"
						step="1"
						value="22"
						aria-label="字号"
					/>
					<button type="button" class="rb-step" data-font-step="1" aria-label="放大字号">A+</button>
				</div>
			</div>
		</header>

		<!-- ==================== 目录抽屉 ==================== -->
		<div id="reader-toc-mask" class="toc-mask" aria-hidden="true"></div>
		<aside id="reader-toc" class="toc-panel" aria-hidden="true">
			<div class="toc-head">
				<b>{novelTitle}</b>
				<span>{chapters.length} 章</span>
			</div>
			<nav class="toc-list">
				{
					chapters.map((c, i) => (
						<a
							href={`${base}${c.slug}/`}
							data-no-swup
							class:list={["toc-item", { active: c.slug === currentSlug }]}
						>
							<span class="toc-num">{String(i + 1).padStart(2, "0")}</span>
							<span class="toc-name">{c.title}</span>
						</a>
					))
				}
			</nav>
			<a class="toc-back" href={base} data-no-swup>小说详情 / 简介</a>
		</aside>

		<!-- ==================== 正文 ==================== -->
		<main id="reader-main">
			<article class="reader-article custom-md">
				<h1 id="reader-title">{chapterTitle}</h1>
				<slot />

				<nav class="reader-pager">
					{prev ? <a href={`${base}${prev.slug}/`} data-no-swup>← {prev.title}</a> : <span />}
					{next ? <a href={`${base}${next.slug}/`} data-no-swup>{next.title} →</a> : <span />}
				</nav>
			</article>
		</main>
	</div>
</Layout>

<style is:global>
	#reader-root {
		--reader-font: 22px;
		--bar-h: 3.5rem;
		min-height: 100dvh;
		background: var(--page-bg, var(--card-bg));
	}

	/* ==================== 工具栏 ==================== */
	.reader-bar {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 40;
		height: var(--bar-h);
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0 0.75rem;
		background: var(--card-bg);
		border-bottom: 1px solid rgba(128, 128, 128, 0.12);
		transition: transform 0.25s ease, opacity 0.25s ease;
	}
	.reader-bar.hidden-bar {
		transform: translateY(-100%);
		opacity: 0;
		pointer-events: none;
	}
	.rb-group {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		flex: none;
	}
	.rb-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		height: 2.5rem;
		padding: 0 0.7rem;
		border: none;
		border-radius: 999px;
		background: transparent;
		color: var(--content-meta, #6b7280);
		font-size: 13.5px;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}
	.rb-btn:hover {
		background: color-mix(in oklab, var(--primary) 10%, transparent);
		color: var(--primary);
	}
	.rb-btn svg {
		font-size: 1.25rem;
	}
	.rb-title {
		flex: 1;
		min-width: 0;
		text-align: center;
		font-size: 12.5px;
		color: var(--content-meta, #8a8a8a);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.rb-font {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}
	.rb-step {
		border: none;
		background: transparent;
		color: var(--content-meta, #6b7280);
		font-size: 12.5px;
		font-weight: 600;
		padding: 0 0.2rem;
		cursor: pointer;
	}
	.rb-step:hover {
		color: var(--primary);
	}
	#rb-font {
		width: 84px;
		accent-color: var(--primary);
		cursor: pointer;
	}

	/* ==================== 目录抽屉（背景必须完全不透） ==================== */
	.toc-mask {
		position: fixed;
		inset: 0;
		z-index: 45;
		background: rgba(0, 0, 0, 0.45);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;
	}
	.toc-mask.on {
		opacity: 1;
		pointer-events: auto;
	}
	.toc-panel {
		position: fixed;
		top: 0;
		bottom: 0;
		left: 0;
		z-index: 46;
		width: min(86vw, 20rem);
		display: flex;
		flex-direction: column;
		/* 双重保险：先用主题卡片色，再叠一层纯色，避免任何半透明透出正文 */
		background: var(--card-bg);
		background-color: var(--card-bg);
		box-shadow: 12px 0 32px rgba(0, 0, 0, 0.18);
		isolation: isolate;
		transform: translateX(-102%);
		transition: transform 0.24s ease;
	}
	.toc-panel.on {
		transform: translateX(0);
	}
	.toc-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 1rem 1rem 0.75rem;
		border-bottom: 1px solid rgba(128, 128, 128, 0.12);
	}
	.toc-head b {
		font-size: 14.5px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.toc-head span {
		flex: none;
		font-size: 11.5px;
		color: var(--content-meta, #8a8a8a);
	}
	.toc-list {
		flex: 1;
		overflow-y: auto;
		padding: 0.5rem;
	}
	.toc-item {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.6rem 0.7rem;
		border-radius: 10px;
		font-size: 13.5px;
		color: var(--content-meta, #4b5563);
		text-decoration: none;
	}
	.toc-item:hover {
		background: color-mix(in oklab, var(--primary) 8%, transparent);
	}
	.toc-item.active {
		background: color-mix(in oklab, var(--primary) 14%, transparent);
		color: var(--primary);
		font-weight: 600;
	}
	.toc-num {
		flex: none;
		font-size: 11px;
		opacity: 0.55;
		font-variant-numeric: tabular-nums;
	}
	.toc-name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.toc-back {
		display: block;
		padding: 0.85rem 1rem;
		border-top: 1px solid rgba(128, 128, 128, 0.12);
		font-size: 12.5px;
		color: var(--primary);
		text-decoration: none;
	}

	/* ==================== 正文（只保留上下滚动） ==================== */
	#reader-main {
		padding-top: var(--bar-h);
		min-height: 100dvh;
	}
	.reader-article {
		max-width: 44rem;
		margin: 0 auto;
		padding: 1.75rem 1.25rem 6rem;
		font-size: var(--reader-font);
		line-height: 1.9;
		color: var(--deep-text, var(--content-meta));
		letter-spacing: 0.01em;
	}
	#reader-title {
		font-size: 1.5em;
		font-weight: 700;
		line-height: 1.45;
		margin: 0 0 1.6em;
		color: var(--deep-text, inherit);
	}
	.reader-pager {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 3rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(128, 128, 128, 0.15);
		font-size: 0.62em;
	}
	.reader-pager a {
		color: var(--primary);
		text-decoration: none;
	}
	.reader-pager a:hover {
		text-decoration: underline;
	}

	@media (max-width: 767px) {
		.rb-title {
			display: none;
		}
		.reader-article {
			padding: 1.1rem 1.05rem 5rem;
			line-height: 1.95;
		}
		#rb-font {
			width: 72px;
		}
	}
</style>

<script>
	// 阅读器交互：字号（无极）、工具栏点击显隐、目录抽屉
	const FONT_KEY = "reader-font";
	const root = document.getElementById("reader-root");
	const bar = document.getElementById("reader-bar");
	const main = document.getElementById("reader-main");
	const fontInput = document.getElementById("rb-font") as HTMLInputElement | null;
	const tocPanel = document.getElementById("reader-toc");
	const tocMask = document.getElementById("reader-toc-mask");

	function applyFont(px: number) {
		const v = Math.min(36, Math.max(16, Math.round(px)));
		root?.style.setProperty("--reader-font", `${v}px`);
		if (fontInput) fontInput.value = String(v);
		try {
			localStorage.setItem(FONT_KEY, String(v));
		} catch {
			/* 隐私模式可能写不了 */
		}
	}

	function closeToc() {
		tocPanel?.classList.remove("on");
		tocMask?.classList.remove("on");
		tocPanel?.setAttribute("aria-hidden", "true");
	}

	if (root && bar && main && !root.dataset.wired) {
		root.dataset.wired = "1";
		let savedFont = 22;
		try {
			savedFont = Number(localStorage.getItem(FONT_KEY)) || 22;
		} catch {
			/* 忽略 */
		}
		applyFont(savedFont);

		fontInput?.addEventListener("input", () => applyFont(Number(fontInput.value)));
		document.querySelectorAll("[data-font-step]").forEach((btn) => {
			btn.addEventListener("click", () => {
				applyFont(Number(fontInput?.value || 22) + Number((btn as HTMLElement).dataset.fontStep || 1));
			});
		});

		document.getElementById("rb-toc")?.addEventListener("click", (e) => {
			e.stopPropagation();
			const open = !tocPanel?.classList.contains("on");
			tocPanel?.classList.toggle("on", open);
			tocMask?.classList.toggle("on", open);
			tocPanel?.setAttribute("aria-hidden", open ? "false" : "true");
		});
		tocMask?.addEventListener("click", closeToc);

		// 单击空白处显隐工具栏（点链接/按钮/图片、选中文字时不触发）
		main.addEventListener("click", (e) => {
			const t = e.target as HTMLElement | null;
			if (!t) return;
			if (t.closest("a, button, input, img, .reader-pager")) return;
			if (window.getSelection && String(window.getSelection()).trim().length > 0) return;
			bar.classList.toggle("hidden-bar");
		});

		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape") closeToc();
		});
	}
</script>
