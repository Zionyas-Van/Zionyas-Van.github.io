---
// ============================================================
// 沉浸式阅读布局（只给小说章节页用）
// 刻意不使用 MainGridLayout：那里有顶栏、侧栏、分类筛选栏、移动端底栏。
// 注意：这里进出阅读页一律整页加载（链接带 data-no-swup），
// 因为 swup 只替换 <main>，两套布局混用会导致组件残留 / 导航被隐藏。
// ============================================================
import { Icon } from "astro-icon/components";
// 阅读页跳过 MainGridLayout，而全站主题变量（--card-bg / --page-bg / --primary）、
// .custom-md 正文样式和滚动条样式都挂在那边带进来的全局样式里。
// 不在这里补上，阅读页拿不到这些变量 → 工具栏/目录抽屉的 background 变成无效值 → 透明透字。
import "../styles/variables.styl";
import "../styles/main.css";
import "../styles/markdown.css";
import "../styles/scrollbar.css";
import Layout from "./Layout.astro";

interface Props {
	chapterTitle: string;
	pageTitle: string;
	description?: string;
	novelId: string;
	novelTitle: string;
	chapters: { slug: string; title: string }[];
	currentSlug: string;
	prev?: { slug: string; title: string } | null;
	next?: { slug: string; title: string } | null;
}

const {
	chapterTitle,
	pageTitle,
	description,
	novelId,
	novelTitle,
	chapters,
	currentSlug,
	prev = null,
	next = null,
} = Astro.props;

const base = `/novels/${novelId}/`;
// 当前是第几章（手机端左下角「1/131」、底部进度条都要用）
const chapterIdx = Math.max(0, chapters.findIndex((c) => c.slug === currentSlug));
---

<Layout title={pageTitle} description={description}>
	<div id="reader-root" data-base={base}>
		<div id="toc" hidden></div>

		<!-- ==================== 顶部工具栏 ==================== -->
		<header id="reader-bar" class="reader-bar">
			<div class="rb-group">
				<a class="rb-btn" href={base} aria-label="返回小说详情" title="返回" data-no-swup>
					<Icon name="material-symbols:arrow-back-rounded" />
				</a>
				<button type="button" class="rb-btn" id="rb-toc" aria-label="目录" title="目录">
					<Icon name="material-symbols:list-rounded" />
					<span>目录</span>
				</button>
			</div>

			<div class="rb-title">{novelTitle}</div>

			<div class="rb-group">
				<div class="rb-font">
					<button type="button" class="rb-step" data-font-step="-1" aria-label="缩小字号">A−</button>
					<input
						id="rb-font"
						type="range"
						min="16"
						max="36"
						step="1"
						value="22"
						aria-label="字号"
					/>
					<button type="button" class="rb-step" data-font-step="1" aria-label="放大字号">A+</button>
				</div>
			</div>
		</header>

		<!-- ===== 手机端默认态：左上角返回 + 书名，左下角进度，右下角时间 ===== -->
		<div id="rd-min" class="rd-min" aria-hidden="true">
			<a class="rd-min-back" href={base} data-no-swup aria-label="返回小说详情">
				<Icon name="material-symbols:arrow-back-rounded" />
			</a>
			<span class="rd-min-novel">{novelTitle}</span>
			<div class="rd-min-foot">
				<span class="rd-min-pos">{chapterIdx + 1}/{chapters.length}</span>
				<span class="rd-min-clock" id="rd-clock"></span>
			</div>
		</div>

		<!-- ===== 手机端工具态：底部进度条 + 目录 + 日夜 ===== -->
		<div id="rd-bottom" class="rd-bottom">
			<div class="rd-prog-row">
			<input
				id="rd-progress"
				type="range"
				min="1"
				max={chapters.length}
				step="1"
				value={chapterIdx + 1}
				aria-label="章节进度"
				data-slugs={JSON.stringify(chapters.map((c) => c.slug))}
			/>
				<span class="rd-prog-num" id="rd-prog-num">{chapterIdx + 1}/{chapters.length}</span>
			</div>
			<div class="rd-bottom-row">
				<button type="button" class="rd-tool" id="rd-toc-btn">
					<Icon name="material-symbols:list-rounded" />
					<span>目录</span>
				</button>
				<button type="button" class="rd-tool" id="rd-theme-btn">
					<Icon name="material-symbols:wb-sunny-outline-rounded" />
					<span>日间/夜间</span>
				</button>
			</div>
		</div>

		<!-- ==================== 目录抽屉 ==================== -->		<div id="reader-toc-mask" class="toc-mask" aria-hidden="true"></div>
		<aside id="reader-toc" class="toc-panel" aria-hidden="true">
			<div class="toc-head">
				<b>{novelTitle}</b>
				<span>{chapters.length} 章</span>
			</div>
			<nav class="toc-list">
				{
					chapters.map((c, i) => (
						<a
							href={`${base}${c.slug}/`}
							data-no-swup
							class:list={["toc-item", { active: c.slug === currentSlug }]}
						>
							<span class="toc-num">{String(i + 1).padStart(2, "0")}</span>
							<span class="toc-name">{c.title}</span>
						</a>
					))
				}
			</nav>
			<a class="toc-back" href={base} data-no-swup>小说详情 / 简介</a>
		</aside>

		<!-- ==================== 正文 ==================== -->
		<main id="reader-main">
			<article class="reader-article custom-md">
				<h1 id="reader-title">{chapterTitle}</h1>
				<slot />

				<nav class="reader-pager">
					{prev ? <a href={`${base}${prev.slug}/`} data-no-swup>← {prev.title}</a> : <span />}
					{next ? <a href={`${base}${next.slug}/`} data-no-swup>{next.title} →</a> : <span />}
				</nav>
			</article>
		</main>
	</div>
</Layout>

<style is:global>
	#reader-root {
		--reader-font: 22px;
		--bar-h: 3.5rem;
		min-height: 100dvh;
		background: var(--page-bg, var(--card-bg));
	}

	/* ==================== 工具栏 ==================== */
	.reader-bar {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 40;
		height: var(--bar-h);
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0 0.75rem;
		background: var(--card-bg);
		border-bottom: 1px solid rgba(128, 128, 128, 0.12);
		transition: transform 0.25s ease, opacity 0.25s ease;
	}
	.reader-bar.hidden-bar {
		transform: translateY(-100%);
		opacity: 0;
		pointer-events: none;
	}
	.rb-group {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		flex: none;
	}
	.rb-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		height: 2.5rem;
		padding: 0 0.7rem;
		border: none;
		border-radius: 999px;
		background: transparent;
		color: var(--content-meta, #6b7280);
		font-size: 13.5px;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}
	.rb-btn:hover {
		background: color-mix(in oklab, var(--primary) 10%, transparent);
		color: var(--primary);
	}
	.rb-btn svg {
		font-size: 1.25rem;
	}
	.rb-title {
		flex: 1;
		min-width: 0;
		text-align: center;
		font-size: 12.5px;
		color: var(--content-meta, #8a8a8a);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.rb-font {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}
	.rb-step {
		border: none;
		background: transparent;
		color: var(--content-meta, #6b7280);
		font-size: 12.5px;
		font-weight: 600;
		padding: 0 0.2rem;
		cursor: pointer;
	}
	.rb-step:hover {
		color: var(--primary);
	}
	#rb-font {
		width: 84px;
		accent-color: var(--primary);
		cursor: pointer;
	}

	/* ==================== 目录抽屉（背景必须完全不透） ==================== */
	.toc-mask {
		position: fixed;
		inset: 0;
		z-index: 45;
		background: rgba(0, 0, 0, 0.45);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;
	}
	.toc-mask.on {
		opacity: 1;
		pointer-events: auto;
	}
	.toc-panel {
		position: fixed;
		top: 0;
		bottom: 0;
		left: 0;
		z-index: 46;
		width: min(86vw, 20rem);
		display: flex;
		flex-direction: column;
		/* 双重保险：先用主题卡片色，再叠一层纯色，避免任何半透明透出正文 */
		background: var(--card-bg);
		background-color: var(--card-bg);
		box-shadow: 12px 0 32px rgba(0, 0, 0, 0.18);
		isolation: isolate;
		transform: translateX(-102%);
		transition: transform 0.24s ease;
	}
	.toc-panel.on {
		transform: translateX(0);
	}
	.toc-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 1rem 1rem 0.75rem;
		border-bottom: 1px solid rgba(128, 128, 128, 0.12);
	}
	.toc-head b {
		font-size: 14.5px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.toc-head span {
		flex: none;
		font-size: 11.5px;
		color: var(--content-meta, #8a8a8a);
	}
	.toc-list {
		flex: 1;
		overflow-y: auto;
		padding: 0.5rem;
	}
	.toc-item {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.6rem 0.7rem;
		border-radius: 10px;
		font-size: 13.5px;
		color: var(--content-meta, #4b5563);
		text-decoration: none;
	}
	.toc-item:hover {
		background: color-mix(in oklab, var(--primary) 8%, transparent);
	}
	.toc-item.active {
		background: color-mix(in oklab, var(--primary) 14%, transparent);
		color: var(--primary);
		font-weight: 600;
	}
	.toc-num {
		flex: none;
		font-size: 11px;
		opacity: 0.55;
		font-variant-numeric: tabular-nums;
	}
	.toc-name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.toc-back {
		display: block;
		padding: 0.85rem 1rem;
		border-top: 1px solid rgba(128, 128, 128, 0.12);
		font-size: 12.5px;
		color: var(--primary);
		text-decoration: none;
	}

	/* ==================== 正文（只保留上下滚动） ==================== */
	#reader-main {
		padding-top: var(--bar-h);
		min-height: 100dvh;
	}
	.reader-article {
		max-width: 44rem;
		margin: 0 auto;
		padding: 1.75rem 1.25rem 6rem;
		font-size: var(--reader-font);
		line-height: 1.9;
		color: var(--deep-text, var(--content-meta));
		letter-spacing: 0.01em;
	}
	/* 段落：渲染时已经切好 <p>，给回正常的段间距 */
	.reader-article p {
		margin: 0.85em 0;
	}
	.reader-article p:first-child {
		margin-top: 0;
	}
	#reader-title {
		font-size: 1.5em;
		font-weight: 700;
		line-height: 1.45;
		margin: 0 0 1.6em;
		color: var(--deep-text, inherit);
	}
	.reader-pager {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 3rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(128, 128, 128, 0.15);
		font-size: 0.62em;
	}
	.reader-pager a {
		color: var(--primary);
		text-decoration: none;
	}
	.reader-pager a:hover {
		text-decoration: underline;
	}

	/* 手机端专用元素在桌面端不显示 */
	.rd-min,
	.rd-bottom {
		display: none;
	}

	/* ==================== 手机端（专业阅读器风格） ====================
	   默认态：只有四角信息（左返回+书名 / 左下进度 / 右下时间），正文铺满；
	   点空白 → 顶部工具栏 + 底部进度条/目录/日夜，再点空白收起。
	   桌面端完全不受影响：下面这段整体包在 max-width:767px 里。 */
	@media (max-width: 767px) {
		/* 默认不显示顶部工具栏 */
		#reader-root:not(.rd-toolbar) .reader-bar {
			transform: translateY(-100%);
			opacity: 0;
			pointer-events: none;
		}
		.reader-bar {
			justify-content: space-between;
			padding: 0 0.75rem;
			padding-top: env(safe-area-inset-top, 0px);
			height: calc(var(--bar-h) + env(safe-area-inset-top, 0px));
			border-bottom: none;
			background: var(--card-bg);
			box-shadow: 0 8px 24px rgba(18, 16, 32, 0.1);
		}
		/* 目录按钮移到底部工具栏，顶部只留返回 + 字号 */
		.rb-group:first-child #rb-toc {
			display: none;
		}
		/* 手机端不用滑杆，改成两个圆形 A− / A+ 按钮 */
		#rb-font {
			display: none;
		}
		.rb-font {
			gap: 8px;
		}
		.rb-step {
			width: 34px;
			height: 34px;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			border-radius: 999px;
			background: color-mix(in oklab, var(--primary) 9%, transparent);
			color: var(--primary);
			font-size: 12.5px;
			font-weight: 700;
			-webkit-tap-highlight-color: transparent;
		}
		.rb-step:active {
			background: color-mix(in oklab, var(--primary) 18%, transparent);
		}
		#reader-main {
			padding-top: 0;
		}
		.reader-article {
			padding: 3.2rem 1.15rem 5rem;
		}
		/* 手机端不显示章节大标题（书名在左上角） */
		#reader-title {
			display: none;
		}
		/* 中文段落首行缩进两个汉字（JSON 里没缩进，这里补上） */
		.reader-article p {
			text-indent: 2em;
			margin: 0.95em 0;
		}
		.reader-article p:has(> img:only-child) {
			text-indent: 0;
		}

		/* 四角信息层 */
		.rd-min {
			display: block;
			position: fixed;
			inset: 0;
			z-index: 30;
			pointer-events: none;
		}
		#reader-root.rd-toolbar .rd-min {
			display: none;
		}
		.rd-min-back {
			pointer-events: auto;
			position: absolute;
			top: calc(env(safe-area-inset-top, 0px) + 4px);
			left: 4px;
			width: 42px;
			height: 42px;
			display: flex;
			align-items: center;
			justify-content: center;
			color: var(--content-meta, #6b7280);
			opacity: 0.7;
			-webkit-tap-highlight-color: transparent;
		}
		.rd-min-novel {
			position: absolute;
			top: calc(env(safe-area-inset-top, 0px) + 15px);
			left: 46px;
			right: 14px;
			font-size: 12.5px;
			color: var(--content-meta, #8a8a8a);
			opacity: 0.62;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}
		.rd-min-foot {
			position: absolute;
			left: 0;
			right: 0;
			bottom: calc(env(safe-area-inset-bottom, 0px) + 8px);
			display: flex;
			justify-content: space-between;
			padding: 0 16px;
			font-size: 12px;
			color: var(--content-meta, #8a8a8a);
			opacity: 0.55;
			font-variant-numeric: tabular-nums;
		}

		/* 底部工具栏 */
		.rd-bottom {
			display: block;
			position: fixed;
			left: 0;
			right: 0;
			bottom: 0;
			z-index: 41;
			padding: 18px 20px calc(env(safe-area-inset-bottom, 0px) + 14px);
			background: var(--card-bg);
			border-radius: 22px 22px 0 0;
			box-shadow: 0 -10px 34px rgba(18, 16, 32, 0.16);
			transform: translateY(110%);
			opacity: 0;
			pointer-events: none;
			transition: transform 0.26s ease, opacity 0.26s ease;
		}
		#reader-root.rd-toolbar .rd-bottom {
			transform: none;
			opacity: 1;
			pointer-events: auto;
		}
		.rd-prog-row {
			display: flex;
			align-items: center;
			gap: 12px;
		}
		.rd-prog-num {
			flex: none;
			font-size: 11.5px;
			font-variant-numeric: tabular-nums;
			color: var(--content-meta, #8a8a8a);
		}
		/* 进度条：4px 圆角轨道 + 主题色填充 + 白色描边滑块 */
		#rd-progress {
			-webkit-appearance: none;
			appearance: none;
			display: block;
			flex: 1;
			width: 100%;
			height: 4px;
			margin: 0;
			border: none;
			border-radius: 999px;
			outline: none;
			cursor: pointer;
			background: linear-gradient(
				to right,
				var(--primary) 0%,
				var(--primary) var(--pct, 0%),
				rgba(128, 128, 128, 0.22) var(--pct, 0%),
				rgba(128, 128, 128, 0.22) 100%
			);
		}
		#rd-progress::-webkit-slider-thumb {
			-webkit-appearance: none;
			appearance: none;
			width: 16px;
			height: 16px;
			border-radius: 50%;
			background: #fff;
			border: 2px solid var(--primary);
			box-shadow: 0 1px 5px rgba(18, 16, 32, 0.25);
			margin-top: -6px;
		}
		#rd-progress::-moz-range-thumb {
			width: 14px;
			height: 14px;
			border-radius: 50%;
			background: #fff;
			border: 2px solid var(--primary);
			box-shadow: 0 1px 5px rgba(18, 16, 32, 0.25);
		}
		#rd-progress::-moz-range-track {
			height: 4px;
			border-radius: 999px;
			background: transparent;
		}
		.rd-bottom-row {
			display: flex;
			align-items: center;
			gap: 8px;
			margin-top: 14px;
		}
		.rd-tool {
			flex: 1;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 5px;
			padding: 6px 0;
			border: none;
			background: transparent;
			color: var(--content-meta, #6b7280);
			font-size: 11.5px;
			cursor: pointer;
			border-radius: 12px;
			-webkit-tap-highlight-color: transparent;
		}
		.rd-tool svg {
			font-size: 1.35rem;
		}
		.rd-tool:active {
			color: var(--primary);
			background: color-mix(in oklab, var(--primary) 8%, transparent);
		}
		/* 工具栏展开时给正文让出底部空间 */
		#reader-root.rd-toolbar .reader-article {
			padding-bottom: 8.5rem;
		}
	}
</style>

<script>
	// 阅读器交互：字号（无极）、工具栏点击显隐、目录抽屉
	const FONT_KEY = "reader-font";
	const root = document.getElementById("reader-root");
	const bar = document.getElementById("reader-bar");
	const main = document.getElementById("reader-main");
	const fontInput = document.getElementById("rb-font") as HTMLInputElement | null;
	const tocPanel = document.getElementById("reader-toc");
	const tocMask = document.getElementById("reader-toc-mask");
	// 手机端走另一套交互（四角信息 + 点按出工具栏），桌面保持原样
	const isMobile = () => window.matchMedia("(max-width: 767px)").matches;

	function applyFont(px: number) {
		const v = Math.min(36, Math.max(16, Math.round(px)));
		root?.style.setProperty("--reader-font", `${v}px`);
		if (fontInput) fontInput.value = String(v);
		try {
			localStorage.setItem(FONT_KEY, String(v));
		} catch {
			/* 隐私模式可能写不了 */
		}
	}

	function closeToc() {
		tocPanel?.classList.remove("on");
		tocMask?.classList.remove("on");
		tocPanel?.setAttribute("aria-hidden", "true");
	}

	if (root && bar && main && !root.dataset.wired) {
		root.dataset.wired = "1";
		let savedFont = 22;
		try {
			savedFont = Number(localStorage.getItem(FONT_KEY)) || 22;
		} catch {
			/* 忽略 */
		}
		applyFont(savedFont);

		fontInput?.addEventListener("input", () => applyFont(Number(fontInput.value)));
		document.querySelectorAll("[data-font-step]").forEach((btn) => {
			btn.addEventListener("click", () => {
				applyFont(Number(fontInput?.value || 22) + Number((btn as HTMLElement).dataset.fontStep || 1));
			});
		});

		document.getElementById("rb-toc")?.addEventListener("click", (e) => {
			e.stopPropagation();
			const open = !tocPanel?.classList.contains("on");
			tocPanel?.classList.toggle("on", open);
			tocMask?.classList.toggle("on", open);
			tocPanel?.setAttribute("aria-hidden", open ? "false" : "true");
		});
		tocMask?.addEventListener("click", closeToc);

		// 单击空白处显隐工具栏（点链接/按钮/图片、选中文字时不触发）
		main.addEventListener("click", (e) => {
			const t = e.target as HTMLElement | null;
			if (!t) return;
			if (t.closest("a, button, input, img, .reader-pager")) return;
			if (window.getSelection && String(window.getSelection()).trim().length > 0) return;
			// 手机端：默认只有四角信息，点一下亮出工具栏，再点收起
			if (isMobile()) root.classList.toggle("rd-toolbar");
			else bar.classList.toggle("hidden-bar");
		});

		/* ===== 手机端专用：时钟 / 进度条 / 目录 / 日夜 ===== */
		if (isMobile()) {
			const clockEl = document.getElementById("rd-clock");
			const tick = () => {
				if (!clockEl) return;
				const d = new Date();
				clockEl.textContent = `${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}`;
			};
			tick();
			setInterval(tick, 20000);

			const prog = document.getElementById("rd-progress") as HTMLInputElement | null;
			const progNum = document.getElementById("rd-prog-num");
			// 进度条填充比例（CSS 用 --pct 画主题色进度）
			const paintProg = () => {
				if (!prog) return;
				const min = Number(prog.min || 1);
				const max = Number(prog.max || 1);
				const v = Number(prog.value || min);
				const pct = max > min ? ((v - min) / (max - min)) * 100 : 100;
				prog.style.setProperty("--pct", `${pct}%`);
				if (progNum) progNum.textContent = `${v}/${max}`;
			};
			paintProg();
			prog?.addEventListener("input", paintProg);
			prog?.addEventListener("change", () => {
				let slugs: string[] = [];
				try {
					slugs = JSON.parse(prog.dataset.slugs || "[]");
				} catch {
					/* 数据坏了就当没点 */
				}
				const slug = slugs[Number(prog.value) - 1];
				if (slug) location.href = `${root.dataset.base || ""}${slug}/`;
			});

			const toggleToc = () => {
				const open = !tocPanel?.classList.contains("on");
				tocPanel?.classList.toggle("on", open);
				tocMask?.classList.toggle("on", open);
				tocPanel?.setAttribute("aria-hidden", open ? "false" : "true");
			};
			document.getElementById("rd-toc-btn")?.addEventListener("click", toggleToc);

			document.getElementById("rd-theme-btn")?.addEventListener("click", () => {
				const dark = document.documentElement.classList.toggle("dark");
				try {
					localStorage.setItem("theme", dark ? "dark" : "light");
				} catch {
					/* 隐私模式可能写不了 */
				}
			});
		}

		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape") closeToc();
		});
	}
</script>
